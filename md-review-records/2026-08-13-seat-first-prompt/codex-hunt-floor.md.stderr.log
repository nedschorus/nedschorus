    51	def project_root() -> Path:
    52	    return Path(os.environ.get("CLAUDE_PROJECT_DIR", ".")).resolve()
    53	
    54	
    55	def is_protected(file_path: str) -> bool:
    56	    path = Path(file_path)
    57	    if path.name in PROTECTED_BASENAMES:
    58	        return True
    59	    parts = path.resolve().parts
    60	    for index, part in enumerate(parts):
    61	        if part == PROTECTED_DIRECTORY:
    62	            if index + 1 < len(parts) and parts[index + 1] in ("worktrees", "jobs"):
    63	                # A worktree checkout's home under .claude/worktrees/, or a
    64	                # background job's scratch directory under .claude/jobs/<id>/tmp
    65	                # — both are working space the harness hands out, not machinery
    66	                # that instructs anybody. The jobs carve-out was added 2026-08-14
    67	                # after a real write tripped the guard, which is the condition
    68	                # this file's docstring sets for adding one.
    69	                continue
    70	            return True
    71	    return False
    72	
    73	
    74	def consume_approval_marker(marker_path: Path) -> bool:
    75	    """One approved change passes; the marker is spent by the call it approves."""
    76	    try:
    77	        content = marker_path.read_text(encoding="utf-8").strip()
    78	    except (FileNotFoundError, OSError):
    79	        return False
    80	    if not content:
    81	        return False
    82	    marker_path.unlink(missing_ok=True)
    83	    return True
    84	
    85	
    86	def main() -> int:
    87	    try:
    88	        payload = json.loads(sys.stdin.read() or "{}")
    89	    except json.JSONDecodeError:
    90	        return 0
    91	    file_path = (payload.get("tool_input") or {}).get("file_path") or ""
    92	    if not file_path or not is_protected(file_path):
    93	        return 0
    94	
    95	    marker_path = project_root() / APPROVAL_MARKER_NAME
    96	    if consume_approval_marker(marker_path):
    97	        return 0
    98	
    99	    print(DENY_MESSAGE.format(path=file_path, marker=APPROVAL_MARKER_NAME), file=sys.stderr)
   100	    return 2
   101	
   102	
   103	if __name__ == "__main__":
   104	    sys.exit(main())
