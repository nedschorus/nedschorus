     1	#!/usr/bin/env python3
     2	"""Soft block on modifying instruction files (user-walked 2026-08-07, nedschorus#45).
     3	
     4	Wired as a PreToolUse hook on Edit, Write, and NotebookEdit. Instruction
     5	files — CLAUDE.md, per-agent CLAUDE.local.md identity files, and everything
     6	under .claude/ — change only through the user's walk. Agents predictably try
     7	to improve them (observed repeatedly in the legacy fleet); a path-scoped rule
     8	cannot stop that (rules are context, not enforcement, and file creation
     9	never triggers them — probed 2026-08-07), so the block lives at the tool
    10	call, where it also catches creation.
    11	
    12	Soft block, not a wall: the deny message teaches the sanctioned path and
    13	names the override. An edit the user has already approved passes once by
    14	writing the user's exact approval words into .walk-approved at the
    15	repository root; the marker is consumed by the passing call. The override is
    16	deliberately self-serve — the audit value is the visible, quoted approval in
    17	the marker and the transcript, not tamper-proofing.
    18	
    19	.claude/ is in the protected set as self-protection: this hook's own wiring
    20	lives in .claude/settings.json, and an unguarded settings file is a guard an
    21	agent can delete.
    22	
    23	The harness's auto-memory under ~/.claude/projects/ is deliberately inside the
    24	protected set (user-ruled 2026-08-11): every memory entry is user-reviewed.
    25	Other harness state (transcripts, handoffs) carries no review requirement — a
    26	carve-out is added when a real harness write trips this guard, not in advance.
    27	Two exist, each added that way: `.claude/worktrees/` (an agent's isolated
    28	checkout) and `.claude/jobs/` (a background job's scratch directory, which the
    29	harness hands out for temporary files and deletes with the job).
    30	"""
    31	
    32	import json
    33	import os
    34	import sys
    35	from pathlib import Path
    36	
    37	PROTECTED_BASENAMES = ("CLAUDE.md", "CLAUDE.local.md")
    38	PROTECTED_DIRECTORY = ".claude"
    39	APPROVAL_MARKER_NAME = ".walk-approved"
    40	
    41	DENY_MESSAGE = (
    42	    "Before modifying {path}, get the user's approval on your change: instruction files "
    43	    "(CLAUDE.md, CLAUDE.local.md identity files, and .claude/ machinery) change only "
    44	    "through the user's walk, however clearly the edit would help. State the proposed "
    45	    "change to the user and walk it with him. If he has already approved this exact "
    46	    "change, quote his exact approval words into {marker} at the repository root, then "
    47	    "resubmit your write or edit — the marker is consumed by the one call it approves."
    48	)
    49	
    50	
    51	def project_root() -> Path:
    52	    return Path(os.environ.get("CLAUDE_PROJECT_DIR", ".")).resolve()
    53	
    54	
    55	def is_protected(file_path: str) -> bool:
    56	    path = Path(file_path)
    57	    if path.name in PROTECTED_BASENAMES:
    58	        return True
    59	    parts = path.resolve().parts
    60	    for index, part in enumerate(parts):
    61	        if part == PROTECTED_DIRECTORY:
    62	            if index + 1 < len(parts) and parts[index + 1] in ("worktrees", "jobs"):
    63	                # A worktree checkout's home under .claude/worktrees/, or a
    64	                # background job's scratch directory under .claude/jobs/<id>/tmp
    65	                # — both are working space the harness hands out, not machinery
    66	                # that instructs anybody. The jobs carve-out was added 2026-08-14
    67	                # after a real write tripped the guard, which is the condition
    68	                # this file's docstring sets for adding one.
    69	                continue
    70	            return True
    71	    return False
    72	
    73	
    74	def consume_approval_marker(marker_path: Path) -> bool:
    75	    """One approved change passes; the marker is spent by the call it approves."""
    76	    try:
    77	        content = marker_path.read_text(encoding="utf-8").strip()
    78	    except (FileNotFoundError, OSError):
    79	        return False
    80	    if not content:
    81	        return False
    82	    marker_path.unlink(missing_ok=True)
    83	    return True
    84	
    85	
    86	def main() -> int:
    87	    try:
    88	        payload = json.loads(sys.stdin.read() or "{}")
    89	    except json.JSONDecodeError:
    90	        return 0
    91	    file_path = (payload.get("tool_input") or {}).get("file_path") or ""
    92	    if not file_path or not is_protected(file_path):
    93	        return 0
    94	
    95	    marker_path = project_root() / APPROVAL_MARKER_NAME
    96	    if consume_approval_marker(marker_path):
    97	        return 0
    98	
    99	    print(DENY_MESSAGE.format(path=file_path, marker=APPROVAL_MARKER_NAME), file=sys.stderr)
