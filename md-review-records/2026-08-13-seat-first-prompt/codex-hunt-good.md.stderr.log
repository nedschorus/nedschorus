    33	set -eu
    34	
    35	# AGENTS_ROOT is a BOX-side path. The default's ~ is expanded by the box's
    36	# shell (it rides unquoted in the remote command), so keep the root free of
    37	# spaces; agent names are charset-checked below for the same reason.
    38	AGENT_BOX="${NEDSCHORUS_AGENT_BOX:-ned}"
    39	AGENTS_ROOT="${NEDSCHORUS_AGENTS_ROOT:-~/agents}"
    40	
    41	# The no-name case is the common mistake, so it teaches rather than scolds:
    42	# what a name is for, and which agents are up on the box right now to pick from
