    44	# only on this error path, never on a launch.
    45	usage() {
    46	    echo "usage: launch-claude-ubuntu <name> [--no-attach] [--first-prompt-file <box-path>]" >&2
    47	    echo >&2
    48	    echo "Every agent is named, and the name is the whole configuration: it names the" >&2
