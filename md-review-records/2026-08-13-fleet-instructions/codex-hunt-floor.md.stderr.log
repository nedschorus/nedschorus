   248	def sync_working_branch_with_main(working_directory: Path) -> str:
   249	    """Bring the agent's branch to main before a session starts. One line back.
   250	
   251	    Ruled 2026-08-13. An agent's home sits on its own branch only because git
   252	    refuses one branch in two worktrees — nobody chose a long-lived personal
   253	    branch, and left alone it drifts from main until someone merges by hand.
   254	    Syncing here, between sessions, is the one safe moment: the previous
   255	    session has exited and the next has not started, so no agent is holding a
   256	    mental model of the tree.
   257	
   258	    Deliberately conservative — it only ever fast-forwards:
   259	
   260	    * uncommitted work, a failed fetch, no origin/main, or a branch carrying
   261	      commits main does not have: report and change nothing;
   262	    * strictly behind main with a clean tree: fast-forward.
   263	
   264	    Never a merge, because a conflicted merge left in the tree before the agent
   265	    wakes is worse than being behind: the branch counts go in the report and
   266	    the agent, which can judge, decides. Callers must not run this against a
   267	    LIVE session's directory — see supervise_sessions, which syncs only on the
   268	    launch path and never on adoption.
   269	    """
   270	    toplevel = run_git_here(["rev-parse", "--show-toplevel"], working_directory, timeout=15)
   271	    if toplevel.returncode != 0:
   272	        return "branch sync: not a git checkout, nothing to sync"
   273	
   274	    fetched = run_git_here(["fetch", "--quiet", "origin"], working_directory)
   275	    fetch_note = "" if fetched.returncode == 0 else " (fetch failed, comparing against what is on disk)"
   276	
   277	    if run_git_here(["rev-parse", "--verify", "--quiet", "origin/main"],
   278	                    working_directory, timeout=15).returncode != 0:
   279	        return f"branch sync: no origin/main to sync with{fetch_note}"
   280	
   281	    branch = run_git_here(["rev-parse", "--abbrev-ref", "HEAD"],
   282	                          working_directory, timeout=15).stdout.strip() or "HEAD"
   283	
   284	    dirty = run_git_here(["status", "--porcelain"], working_directory, timeout=30).stdout.strip()
   285	    if dirty:
   286	        return (f"branch sync: {branch} left as is — {len(dirty.splitlines())} uncommitted "
   287	                f"path(s) in the tree{fetch_note}")
   288	
   289	    if run_git_here(["merge-base", "--is-ancestor", "origin/main", "HEAD"],
   290	                    working_directory, timeout=15).returncode == 0:
   291	        ahead = run_git_here(["rev-list", "--count", "origin/main..HEAD"],
   292	                             working_directory, timeout=30).stdout.strip() or "?"
   293	        if ahead == "0":
   294	            return f"branch sync: {branch} is current with main{fetch_note}"
   295	        return (f"branch sync: {branch} is {ahead} commit(s) ahead of main and has all of "
   296	                f"it — nothing to pull{fetch_note}")
   297	
   298	    if run_git_here(["merge-base", "--is-ancestor", "HEAD", "origin/main"],
   299	                    working_directory, timeout=15).returncode == 0:
   300	        merged = run_git_here(["merge", "--ff-only", "origin/main"], working_directory)
   301	        if merged.returncode != 0:
   302	            return (f"branch sync: {branch} could not fast-forward: "
   303	                    f"{merged.stderr.strip() or 'no detail'}{fetch_note}")
   304	        tip = run_git_here(["rev-parse", "--short", "HEAD"],
   305	                           working_directory, timeout=15).stdout.strip()
   306	        return f"branch sync: {branch} fast-forwarded to main ({tip}){fetch_note}"
   307	
   308	    ahead = run_git_here(["rev-list", "--count", "origin/main..HEAD"],
   309	                         working_directory, timeout=30).stdout.strip() or "?"
   310	    behind = run_git_here(["rev-list", "--count", "HEAD..origin/main"],
   311	                          working_directory, timeout=30).stdout.strip() or "?"
   312	    return (f"branch sync: {branch} is {ahead} ahead of main and {behind} behind — merge when "
   313	            f"ready (git merge origin/main){fetch_note}")
