   402	def wait_for_handoff(process, handoff_path: Path, consumed_counter, state_path: Path, state: dict):
   403	    """Block until the agent writes a new handoff, or the session exits.
   404	
   405	    Returns the handoff fields when a counter above `consumed_counter`
   406	    appears, or None if the session ended on its own without writing one.
   407	    Stamps the heartbeat while it waits, so the watched agent can tell a
   408	    live supervisor from a dead one.
   409	
   410	    The exit check must not preempt the file check: a headless session exits
   411	    when its turn ends, so its handoff arrives AS a process exit — the file
   412	    was written during the turn, before the exit was observable. Exit with a
   413	    new counter on disk is a handoff; exit without one is abandonment.
   414	    """
   415	    last_stamp = 0.0
   416	    while True:
   417	        exited = process.poll() is not None
   418	
   419	        if time.monotonic() - last_stamp >= HEARTBEAT_INTERVAL_SECONDS:
   420	            stamp_heartbeat(state_path, state)
   421	            last_stamp = time.monotonic()
   422	
   423	        if handoff_path.is_file():
   424	            fields = parse_handoff_file(handoff_path)
   425	            counter = counter_from(fields)
   426	            if counter is not None and (consumed_counter is None or counter > consumed_counter):
   427	                return fields
   428	
   429	        if exited:
   430	            return None
   431	
   432	        time.sleep(HANDOFF_POLL_SECONDS)
   433	
