   152	def preseed_tasks(retiring_session_id: str, successor_session_id: str) -> int:
   153	    """Copy task records into the successor's directory before it boots.
   154	
   155	    Rides undocumented harness state: tasks are <N>.json files under
   156	    ~/.claude/tasks/<session-id>/, and a session started with an explicit id
   157	    reads whatever is already there. An upgrade breaking this is detected at
   158	    the successor's ignition count-check, with the queues as the backstop
   159	    (per-upgrade canary re-runs were dropped as a remembered duty,
   160	    user-ruled 2026-08-12); the canaries in handoff-supervisor-test.py
   161	    (--canary) diagnose it when that fires.
   162	    """
   163	    source = TASKS_ROOT / retiring_session_id
   164	    if not source.is_dir():
   165	        return 0
   166	    destination = TASKS_ROOT / successor_session_id
   167	    destination.mkdir(parents=True, exist_ok=True)
   168	    copied = 0
   169	    for task_file in sorted(source.glob("*.json")):
   170	        shutil.copy2(task_file, destination / task_file.name)
   171	        copied += 1
   172	    return copied
