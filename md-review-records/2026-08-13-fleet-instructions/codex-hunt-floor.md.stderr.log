   371	def claim_supervisor_lock(lock_path: Path) -> bool:
   372	    """Take the one-supervisor-per-agent lock, or report it already held.
   373	
   374	    Two supervisors on one agent would each kill the session and each launch a
   375	    successor, so the second must not start. A lock left by a supervisor that
   376	    died is reclaimed: the recorded process id is checked before the lock is
   377	    believed.
   378	    """
   379	    lock_path.parent.mkdir(parents=True, exist_ok=True)
   380	    try:
   381	        descriptor = os.open(str(lock_path), os.O_CREAT | os.O_EXCL | os.O_WRONLY)
   382	    except FileExistsError:
   383	        try:
   384	            holder = int(lock_path.read_text(encoding="utf-8").strip())
   385	        except (ValueError, OSError):
   386	            holder = None
   387	        if holder is not None and holder != os.getpid():
   388	            try:
   389	                os.kill(holder, 0)
   390	                return False  # a live supervisor already holds this agent
   391	            except ProcessLookupError:
   392	                pass
   393	            except PermissionError:
   394	                return False
   395	        lock_path.unlink(missing_ok=True)  # the holder is gone; reclaim it
   396	        return claim_supervisor_lock(lock_path)
   397	    os.write(descriptor, f"{os.getpid()}\n".encode("utf-8"))
   398	    os.close(descriptor)
   399	    return True
