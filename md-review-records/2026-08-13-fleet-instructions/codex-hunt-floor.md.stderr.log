   324	class AdoptedSession:
   325	    """A session this supervisor did not launch, identified by process id.
   326	
   327	    A supervisor normally owns the process it started and can terminate it
   328	    through that handle. A session started by hand — the founding boot, or any
   329	    agent a person launched in a console — has no such owner, so it can never
   330	    recycle. Adoption closes that: the agent's own handoff script starts a
   331	    supervisor and tells it which process to watch, and everything after the
   332	    kill is identical to the ordinary cycle.
   333	    """
   334	
   335	    def __init__(self, session_id: str, process_id: int):
   336	        self.session_id = session_id
   337	        self.process_id = process_id
   338	
   339	    def poll(self):
   340	        """Return None while the process is alive, 0 once it is gone."""
   341	        try:
   342	            os.kill(self.process_id, 0)
   343	        except ProcessLookupError:
   344	            return 0
   345	        except PermissionError:
   346	            return None  # alive, owned by someone else
   347	        return None
   348	
   349	    def terminate(self):
   350	        try:
   351	            os.kill(self.process_id, signal.SIGTERM)
   352	        except ProcessLookupError:
   353	            pass
   354	
   355	    def kill(self):
   356	        try:
   357	            os.kill(self.process_id, signal.SIGKILL)
   358	        except ProcessLookupError:
   359	            pass
   360	
   361	    def wait(self, timeout=None):
   362	        """Block until the process is gone, or raise once the timeout passes."""
   363	        deadline = time.monotonic() + (timeout if timeout is not None else 0)
   364	        while self.poll() is None:
   365	            if timeout is not None and time.monotonic() > deadline:
   366	                raise subprocess.TimeoutExpired(f"pid {self.process_id}", timeout)
   367	            time.sleep(0.2)
   368	        return 0
   369	
