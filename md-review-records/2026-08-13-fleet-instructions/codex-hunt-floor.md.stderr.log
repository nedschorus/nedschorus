   508	def supervise_sessions(settings: SupervisorSettings) -> int:
   509	    """Launch, watch, and recycle sessions until one ends without a handoff."""
   510	    state = read_supervisor_state(settings.state_path)
   511	    generation = state.get("generation", 0)
   512	    prompt = settings.first_prompt or (
   513	        f"You are {settings.agent}. No handoff exists yet; ask what to work on."
   514	    )
   515	
   516	    adopted = settings.adopted_session
   517	    # A fresh start always mints a new session id. Reusing the one in the state
   518	    # file would launch `claude --session-id` against a transcript that already
   519	    # exists — and if the supervisor died while its agent kept running, would put
   520	    # two processes on one session id. Adoption is how a running session is
   521	    # picked back up.
   522	    session_id = adopted.session_id if adopted else str(uuid.uuid4())
   523	
   524	    print(f"handoff-supervisor: {settings.agent} in {settings.working_directory}")
   525	    print(f"handoff-supervisor: watching {settings.handoff_path}")
   526	
   527	    while True:
   528	        state.update({"session_id": session_id, "generation": generation})
   529	        write_supervisor_state(settings.state_path, state)
   530	
   531	        if adopted is not None:
   532	            print(
   533	                f"handoff-supervisor: adopted running session {session_id} "
   534	                f"(process {adopted.process_id}, generation {generation})"
   535	            )
   536	            process, adopted = adopted, None  # adoption applies to this pass only
   537	        else:
   538	            # Only on the launch path: an adopted session is alive in this
   539	            # directory, and changing files under a working agent is the one
   540	            # thing this must never do.
   541	            print(f"handoff-supervisor: {sync_working_branch_with_main(settings.working_directory)}")
   542	            print(f"handoff-supervisor: launching session {session_id} (generation {generation})")
   543	            process = launch_agent_session(
   544	                settings.agent_command, session_id, settings.working_directory, prompt
   545	            )
   546	
   547	        handoff_fields = wait_for_handoff(
   548	            process, settings.handoff_path, state.get("consumed_counter"), settings.state_path, state
   549	        )
   550	        if handoff_fields is None:
   551	            print("handoff-supervisor: session ended without a handoff; supervisor stopping")
   552	            return 0
   553	
   554	        stop_session(process)
