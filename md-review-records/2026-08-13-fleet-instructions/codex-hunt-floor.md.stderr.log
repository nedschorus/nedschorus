   237	def run_git_here(arguments: list, working_directory: Path, timeout: int = 60):
   238	    """Run git in the agent's directory; never raise, whatever goes wrong."""
   239	    try:
   240	        return subprocess.run(
   241	            ["git", *arguments], cwd=str(working_directory),
   242	            capture_output=True, text=True, check=False, timeout=timeout,
   243	        )
   244	    except (OSError, subprocess.SubprocessError) as error:
   245	        return subprocess.CompletedProcess(arguments, 1, "", f"{type(error).__name__}: {error}")
