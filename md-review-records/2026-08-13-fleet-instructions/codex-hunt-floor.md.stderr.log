   175	def queue_status_line(working_directory: Path) -> str:
   176	    """Report each queue's depth and oldest item, so rot stays visible."""
   177	    reports = []
   178	    for queue_directory in ("nc-queue", "docs/issues/queue", "docs/wiki/queue", "legacy-feature-queue"):
