   183	            item for item in directory.glob("*.md") if item.name.lower() != "readme.md"
   184	        )
   185	        if not entries:
   186	            reports.append(f"{queue_directory}: empty")
   187	            continue
   188	        oldest = min(entries, key=lambda item: item.name)
   189	        reports.append(f"{queue_directory}: {len(entries)}, oldest {oldest.name}")
   190	    return "queues — " + ("; ".join(reports) if reports else "none found")
