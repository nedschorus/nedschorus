   435	def stop_session(process) -> None:
   436	    process.terminate()
   437	    try:
   438	        process.wait(timeout=20)
   439	    except subprocess.TimeoutExpired:
   440	        print("handoff-supervisor: session ignored terminate; killing", file=sys.stderr)
   441	        process.kill()
   442	        process.wait()
