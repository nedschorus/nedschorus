   149	def workspace_root() -> Path:
   150	    """B4a: outside every repository, discoverable from the digest alone —
   151	    on the host that created it (§ States; host locality ruled 2026-08-12)."""
   152	    state_home = os.environ.get("XDG_STATE_HOME")
   153	    base = Path(state_home) if state_home else Path.home() / ".local" / "state"
   154	    return base / WORKSPACE_ROOT_NAME
   155	
   156	
   157	def workspace_for(digest: str) -> Path | None:
   158	    """The workspace a digest names, or None — found by enumeration, never by
   159	    joining the digest onto the root (ruled 2026-08-12).
   160	
   161	    `status` and `cancel` take their digest from the caller, and path arithmetic
   162	    on caller text escapes the root: an absolute argument discards the root
   163	    entirely, and `..` climbs out of it. `cancel` deleted the named directory
   164	    and answered `cancelled`; `status` returned a foreign refusal record as its
   165	    own reply and then deleted it. Matching a name against the entries the
   166	    program itself created cannot escape whatever the argument says, so the
   167	    property holds by construction rather than by filtering — which is why no
   168	    separate format check on the digest exists.
