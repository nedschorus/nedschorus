     1	#!/usr/bin/env python3
     2	"""Run one Codex cell of a md-review clarity matrix against a document.
     3	
     4	One invocation = one cell. The prompt templates in
     5	.claude/skills/md-review/prompts/ are the single prompt source for BOTH
     6	runtimes' cells: Claude subagent cells are prompted with the same template
     7	text, so the two legs cannot drift apart.
     8	
     9	Usage:
    10	  scripts/md-review-codex-cell.py --cell restate --tier floor --target docs/cross-project/foo.md
    11	  scripts/md-review-codex-cell.py --cell defect-hunt --tier good --target .claude/skills/x/SKILL.md
    12	
    13	The cell's final message prints to stdout; codex progress output stays on
    14	stderr. Exit codes: 0 cell ran, 2 bad invocation, else codex exec's code.
    15	"""
    16	
    17	import argparse
    18	import pathlib
    19	import subprocess
    20	import sys
    21	import tempfile
    22	
    23	REPO_ROOT = pathlib.Path(__file__).resolve().parent.parent
    24	PROMPTS_DIR = REPO_ROOT / ".claude" / "skills" / "md-review" / "prompts"
    25	
    26	# Tier -> Codex model id. One place to update as models change. Good tier
    27	# user-picked and live-verified 2026-08-03; floor moved terra -> luna at the
    28	# user's direction 2026-08-11, live-verified the same day (the bare names
    29	# "sol"/"luna" are rejected by the CLI; the version-prefixed ids are the
    30	# accepted form).
    31	TIER_TO_CODEX_MODEL = {
    32	    "good": "gpt-5.6-sol",
    33	    "floor": "gpt-5.6-luna",
    34	}
    35	
    36	# Tier -> reasoning effort, pinned explicitly so a cell's behavior never
    37	# depends on the machine-local ~/.codex/config.toml default. xhigh for both
    38	# tiers by user calibration 2026-08-03 ("xhigh is OK for codex").
    39	TIER_TO_REASONING_EFFORT = {
    40	    "good": "xhigh",
    41	    "floor": "xhigh",
    42	}
    43	
    44	
    45	def main() -> int:
    46	    parser = argparse.ArgumentParser(
    47	        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    48	    )
    49	    parser.add_argument("--cell", required=True, choices=["restate", "defect-hunt"])
    50	    parser.add_argument("--tier", required=True, choices=["good", "floor"])
    51	    parser.add_argument(
    52	        "--target", required=True, help="document path, relative to the repo root or absolute"
    53	    )
    54	    parser.add_argument("--model", help="explicit Codex model id; overrides the tier mapping")
    55	    args = parser.parse_args()
    56	
    57	    target = pathlib.Path(args.target)
    58	    if not target.is_absolute():
    59	        target = REPO_ROOT / target
    60	    if not target.is_file():
    61	        print(f"md-review-codex-cell: target not found: {target}", file=sys.stderr)
    62	        return 2
    63	
    64	    template_path = PROMPTS_DIR / f"{args.cell}.md"
    65	    if not template_path.is_file():
    66	        print(f"md-review-codex-cell: prompt template missing: {template_path}", file=sys.stderr)
    67	        return 2
    68	    prompt = template_path.read_text(encoding="utf-8").replace("{TARGET_PATH}", str(target))
    69	
    70	    model = args.model or TIER_TO_CODEX_MODEL[args.tier]
    71	    last_message_path = pathlib.Path(tempfile.mkstemp(suffix=".md", prefix="md-review-cell-")[1])
    72	    command = [
    73	        "codex", "exec",
    74	        "--sandbox", "read-only",
    75	        "-C", str(REPO_ROOT),
    76	        "--output-last-message", str(last_message_path),
    77	    ]
    78	    if model:
    79	        command += ["-m", model]
    80	    command += ["-c", f"model_reasoning_effort={TIER_TO_REASONING_EFFORT[args.tier]}"]
    81	    command.append(prompt)
    82	
    83	    # stdin MUST be closed explicitly: `codex exec` treats a piped-open stdin
    84	    # as content to append and reads it to EOF before starting the turn, so an
    85	    # inherited never-closing descriptor deadlocks the cell (measured
    86	    # 2026-08-03: four cells frozen 24 minutes in background execution).
    87	    completed = subprocess.run(
    88	        command,
    89	        stdin=subprocess.DEVNULL,
    90	        stdout=sys.stderr,
    91	        stderr=sys.stderr,
    92	        text=True,
    93	        check=False,
    94	    )
    95	    if completed.returncode != 0:
    96	        print(
    97	            f"md-review-codex-cell: codex exec failed (exit {completed.returncode})",
    98	            file=sys.stderr,
    99	        )
   100	        return completed.returncode
   101	
   102	    # Provenance header for the review record: the which-cells-earn-their-keep
   103	    # analysis needs every cell output pinned to its exact model and effort
   104	    # (tier names drift across model eras; pins do not). User-required 2026-08-04.
   105	    print(
   106	        f"<!-- provenance: runtime=codex model={model or 'config-default'} "
   107	        f"effort={TIER_TO_REASONING_EFFORT[args.tier]} cell={args.cell} "
   108	        f"tier={args.tier} target={args.target} -->\n"
   109	    )
   110	    print(last_message_path.read_text(encoding="utf-8"))
   111	    last_message_path.unlink(missing_ok=True)
   112	    return 0
   113	
   114	
   115	if __name__ == "__main__":
   116	    sys.exit(main())
