   121	class Refusal(Exception):
   122	    """A named catalog refusal: the error, the facts, and the exact next act.
   123	
   124	    Never a bare error code. B5: the next action is verb-first and specific —
   125	    "resubmit without that path", never "fix the problem" — and
   126	    one term is used per concept across the whole catalog, because agents
   127	    pattern-match this text. A path is always a "path", never a "file".
   128	    """
   129	
   130	    def __init__(self, error: str, facts: str, next_action: str):
   131	        super().__init__(f"{error}: {facts}")
   132	        self.error = error
   133	        self.facts = facts
   134	        self.next_action = next_action
   135	
   136	
   137	class AlreadyCheckedIn(Exception):
