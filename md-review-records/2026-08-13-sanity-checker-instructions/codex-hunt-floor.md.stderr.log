     1	#!/usr/bin/env python3
     2	"""Run one cell of the sanity-checker attack-split validation experiment.
     3	
     4	The experiment (grid-seat rulings, user-walked 2026-08-12, recorded in
     5	docs/drafts/sanity-checker-prompt-draft.md): three stance attacks x two
     6	runtimes x two ground-truth documents, scored afterward against the recorded
     7	rulings. One invocation = one cell, mirroring the md-review cell launchers.
     8	
     9	  scripts/sanity-checker-attack-experiment.py --attack cut --runtime claude --doc gatekeeper
    10	
    11	Attacks: cut, mechanization, fresh-eyes. Runtimes: claude (Fable, xhigh),
    12	codex (gpt-5.6-sol, xhigh). Docs: gatekeeper (the archived pre-walk spec),
    13	fast-handoff (the archived pre-gut design).
    14	
    15	The cut and mechanization cells read the target and its pinned context set
    16	from the repository, isolated by instruction exactly as the original
    17	calibration runs were. The fresh-eyes cell receives only the problem
    18	statement, inlined, and runs from an empty scratch directory so it cannot
    19	find the design it must stay independent of.
    20	
    21	Output lands in md-review-records/2026-08-12-attack-split-experiment/ as
    22	<doc>-<attack>-<runtime>.md with a provenance stamp. Exit codes: 0 cell ran,
    23	2 bad invocation, else the runtime CLI's code.
    24	"""
    25	
    26	import argparse
    27	import pathlib
    28	import subprocess
    29	import sys
    30	import tempfile
    31	
    32	REPO_ROOT = pathlib.Path(__file__).resolve().parent.parent
    33	EXPERIMENT_DIR = REPO_ROOT / "md-review-records" / "2026-08-12-attack-split-experiment"
    34	INPUTS_DIR = EXPERIMENT_DIR / "inputs"
    35	
    36	CLAUDE_MODEL = "claude-fable-5"
    37	CODEX_MODEL = "gpt-5.6-sol"
    38	REASONING_EFFORT = "xhigh"
    39	CELL_TIMEOUT_SECONDS = 3600
    40	
    41	ATTACK_PROMPT_FILES = {
    42	    "cut": REPO_ROOT / "docs/drafts/sanity-checker-cut-attack-prompt-draft.md",
    43	    "mechanization": REPO_ROOT / "docs/drafts/sanity-checker-mechanization-attack-prompt-draft.md",
    44	    "fresh-eyes": REPO_ROOT / "docs/drafts/sanity-checker-fresh-eyes-attack-prompt-draft.md",
    45	}
    46	
    47	# Target + pinned context per document, matching the original ground-truth
    48	# runs so scores compare like with like.
    49	DOC_SETS = {
    50	    "gatekeeper": {
    51	        "target": "md-review-records/2026-08-12-sanity-checker-calibration/reviewed-spec-at-0890848.md",
    52	        "target_description": "the git-gatekeeper design at its 2026-08-09 revision (archived snapshot)",
    53	        "context": [
    54	            "md-review-records/2026-08-12-attack-split-experiment/inputs/context-build-slice-plan-at-0890848.md",
    55	            "md-review-records/2026-08-12-attack-split-experiment/inputs/context-credential-bindings-at-0890848.md",
    56	            "md-review-records/2026-08-12-attack-split-experiment/inputs/context-fast-handoff-design-at-0890848.md",
    57	        ],
    58	        "problem_statement": INPUTS_DIR / "problem-statement-gatekeeper.md",
    59	    },
    60	    "fast-handoff": {
    61	        "target": "md-review-records/2026-08-12-fast-handoff-sanity-check/reviewed-fast-handoff-design.md",
    62	        "target_description": "the fast-handoff design at its pre-gut revision (archived snapshot)",
    63	        "context": [
    64	            ".claude/skills/handoff/SKILL.md",
    65	            "docs/drafts/handoff-skill-draft.md",
    66	        ],
    67	        "problem_statement": INPUTS_DIR / "problem-statement-fast-handoff.md",
    68	    },
    69	}
    70	
    71	
    72	def prompt_body(attack: str) -> str:
    73	    """The prompt below the draft file's status rule."""
    74	    text = ATTACK_PROMPT_FILES[attack].read_text(encoding="utf-8")
    75	    marker = "\n---\n"
    76	    if marker not in text:
    77	        raise SystemExit(f"attack draft has no status rule: {ATTACK_PROMPT_FILES[attack]}")
    78	    return text.split(marker, 1)[1].strip()
    79	
    80	
    81	def assemble_prompt(attack: str, doc: str) -> str:
    82	    doc_set = DOC_SETS[doc]
    83	    if attack == "fresh-eyes":
    84	        problem = doc_set["problem_statement"].read_text(encoding="utf-8")
    85	        return (
    86	            prompt_body(attack)
    87	            + "\n\n---\n\nThe review request follows: the problem statement is below. "
    88	            "It is your complete input; do not read files or search for anything.\n\n"
    89	            + problem
    90	        )
    91	    context_lines = "\n".join(f"- {path}" for path in doc_set["context"])
    92	    request = (
    93	        f"Review request: the document under review is `{doc_set['target']}` — "
    94	        f"{doc_set['target_description']}. Context documents:\n{context_lines}\n\n"
    95	        "These files are your complete document set: do not search for or read any "
    96	        "other file, including documents they link. Where a finding depends on "
    97	        "something you cannot read, say so plainly rather than chasing it."
    98	    )
    99	    return prompt_body(attack) + "\n\n---\n\n" + request
   100	
   101	
   102	def run_claude(prompt: str, isolated: bool) -> tuple:
   103	    command = [
   104	        "claude", "-p",
   105	        "--model", CLAUDE_MODEL,
   106	        "--effort", REASONING_EFFORT,
   107	        "--output-format", "text",
   108	        "--allowedTools", "Read,Grep",
   109	    ]
   110	    cwd = REPO_ROOT
   111	    if isolated:
   112	        cwd = pathlib.Path(tempfile.mkdtemp(prefix="fresh-eyes-cell-"))
   113	    completed = subprocess.run(
   114	        command, input=prompt, stdout=subprocess.PIPE, stderr=sys.stderr,
   115	        cwd=cwd, text=True, check=False, timeout=CELL_TIMEOUT_SECONDS,
   116	    )
   117	    return completed.returncode, completed.stdout
   118	
   119	
   120	def run_codex(prompt: str, isolated: bool) -> tuple:
   121	    last_message_path = pathlib.Path(tempfile.mkstemp(suffix=".md", prefix="attack-cell-")[1])
   122	    cwd = REPO_ROOT
   123	    if isolated:
   124	        cwd = pathlib.Path(tempfile.mkdtemp(prefix="fresh-eyes-cell-"))
   125	    command = [
   126	        "codex", "exec",
   127	        "--sandbox", "read-only",
   128	        "-C", str(cwd),
   129	        "--output-last-message", str(last_message_path),
   130	        "-m", CODEX_MODEL,
   131	        "-c", f"model_reasoning_effort={REASONING_EFFORT}",
   132	    ]
   133	    if isolated:
   134	        # The scratch directory is deliberately not a git repository; codex
   135	        # refuses untrusted non-repo directories without this flag.
   136	        command.append("--skip-git-repo-check")
   137	    command.append(prompt)
   138	    completed = subprocess.run(
   139	        command, stdin=subprocess.DEVNULL, stdout=sys.stderr, stderr=sys.stderr,
   140	        text=True, check=False, timeout=CELL_TIMEOUT_SECONDS,
   141	    )
   142	    if completed.returncode != 0:
   143	        return completed.returncode, ""
   144	    output = last_message_path.read_text(encoding="utf-8")
   145	    last_message_path.unlink(missing_ok=True)
   146	    return 0, output
   147	
   148	
   149	def main() -> int:
   150	    parser = argparse.ArgumentParser(
   151	        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
   152	    )
   153	    parser.add_argument("--attack", required=True, choices=sorted(ATTACK_PROMPT_FILES))
   154	    parser.add_argument("--runtime", required=True, choices=["claude", "codex"])
   155	    parser.add_argument("--doc", required=True, choices=sorted(DOC_SETS))
   156	    args = parser.parse_args()
   157	
   158	    prompt = assemble_prompt(args.attack, args.doc)
   159	    isolated = args.attack == "fresh-eyes"
   160	    runner = run_claude if args.runtime == "claude" else run_codex
   161	    code, output = runner(prompt, isolated)
   162	    if code != 0:
   163	        print(
   164	            f"sanity-checker-attack-experiment: {args.runtime} cell failed (exit {code})",
   165	            file=sys.stderr,
   166	        )
   167	        return code
   168	
   169	    model = CLAUDE_MODEL if args.runtime == "claude" else CODEX_MODEL
   170	    output_path = EXPERIMENT_DIR / f"{args.doc}-{args.attack}-{args.runtime}.md"
   171	    output_path.write_text(
   172	        f"<!-- provenance: runtime={args.runtime} model={model} effort={REASONING_EFFORT} "
   173	        f"attack={args.attack} doc={args.doc} "
   174	        f"isolation={'empty-scratch-directory' if isolated else 'instruction-pinned document set'} -->\n\n"
   175	        + output,
   176	        encoding="utf-8",
   177	    )
   178	    print(f"cell complete: {output_path}")
   179	    return 0
   180	
   181	
