from pathlib import Path

WORKSPACE_ROOT_NAME = "nedschorus-gatekeeper"
CANDIDATE_BRANCH = "git-gatekeeper-candidate"
MAIN_BRANCH = "main"

FULL_COMMIT_ID = re.compile(r"^[0-9a-f]{40}$")
ISSUE_NUMBER = re.compile(r"^[1-9][0-9]*$")

