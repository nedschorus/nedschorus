   654	def attempt_push(clone: Path) -> tuple[bool, str]:
   655	    """One atomic push attempt. Returns (won, stderr).
   656	
   657	    Everything rests on the one property GitHub provides: a push either wins
   658	    cleanly or is rejected whole — never partial, never interleaved. That is
   659	    the arbiter, which is why no queue and no lock exist here.
   660	    """
   661	    pushed = subprocess.run(
   662	        ["git", "push", "--quiet", "origin", f"{CANDIDATE_BRANCH}:{MAIN_BRANCH}"],
   663	        cwd=str(clone), capture_output=True, text=True, check=False,
   664	    )
   665	    return pushed.returncode == 0, pushed.stderr.strip()
