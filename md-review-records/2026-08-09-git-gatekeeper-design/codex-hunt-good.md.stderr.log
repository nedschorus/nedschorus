   838	def parse_import_trailers(commit_id: str, when: str, body: str) -> list[dict]:
   839	    """Every Gatekeeper-import line on one commit becomes one row.
   840	
   841	    B2's parser stance: repeated lines are the hand-pushed bypass class — the
   842	    program itself writes at most one — and each still derives a row, so a
   843	    bypass shows up in the table rather than being silently collapsed.
   844	    """
   845	    rows = []
   846	    for line in body.splitlines():
   847	        stripped = line.strip()
   848	        if not stripped.startswith("Gatekeeper-import:"):
   849	            continue
   850	        value = stripped.split(":", 1)[1].strip()
   851	        if value == "none":
   852	            continue
   853	        source, separator, destination = value.partition(f" {UNSAFE_PATH_MARKER} ")
   854	        legacy_commit, _, source_path = source.partition(" ")
   855	        if not separator or not legacy_commit or not source_path or not destination:
   856	            rows.append({
   857	                "commit": commit_id, "when": when, "malformed": value,
   858	            })
   859	            continue
   860	        rows.append({
   861	            "commit": commit_id, "when": when, "legacy_commit": legacy_commit,
   862	            "source": source_path, "destination": destination.strip(),
   863	        })
   864	    return rows
   865	
   866	
   867	def imports_table(arguments) -> int:
   868	    """The import table, derived from history — never from a side file.
   869	
   870	    This derived view replaces the retired entry-manifest row rule: a shared
   871	    append-file would make any two parallel imports conflict by construction,
   872	    and would duplicate what the trailer already says.
   873	    """
   874	    repository = resolve_repository(arguments.repo)
   875	    remote = resolve_remote(repository, arguments.remote)
   876	
   877	    workspace_root().mkdir(parents=True, exist_ok=True)
   878	    scratch = Path(tempfile.mkdtemp(prefix="imports-", dir=workspace_root()))
   879	    try:
   880	        clone = prepare_clone(scratch, remote)
   881	        separator = "\x1e"
   882	        log = run_git(
   883	            ["log", f"origin/{MAIN_BRANCH}", f"--format=%H%x1f%aI%x1f%B{separator}"],
   884	            cwd=clone,
   885	        )
   886	        rows: list[dict] = []
   887	        for record in log.stdout.split(separator):
   888	            if not record.strip():
   889	                continue
   890	            commit_id, _, rest = record.strip().partition("\x1f")
   891	            when, _, body = rest.partition("\x1f")
   892	            rows.extend(parse_import_trailers(commit_id, when, body))
   893	        rows.reverse()  # oldest first: the order the imports actually happened
   894	
   895	        summary = (f"{len(rows)} import(s) recorded on main" if rows
   896	                   else "no imports recorded on main")
   897	        return emit({"outcome": "imports", "imports": rows, "summary": summary}, EXIT_SUCCESS)
   898	    finally:
   899	        shutil.rmtree(scratch, ignore_errors=True)
