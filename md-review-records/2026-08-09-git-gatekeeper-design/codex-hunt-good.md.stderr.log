   902	def unbuilt_command(name: str, slice_number: int) -> int:
   903	    raise Refusal(
   904	        "unbuilt-option", f"the {name} command is not built in this version",
   905	        f"Nothing to do: {name} arrives in slice {slice_number} of the git-gatekeeper "
   906	        "build (nedschorus#3). Until then, resubmit the work itself with check-in — "
   907	        "resubmitting is always safe.",
   908	    )
