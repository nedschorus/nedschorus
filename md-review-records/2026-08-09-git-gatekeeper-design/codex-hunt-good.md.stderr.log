   572	        ["git", "clone", "--quiet", "--no-checkout", remote, str(clone)],
   573	        capture_output=True, text=True, check=False,
   574	    )
   575	    if cloned.returncode != 0:
   576	        raise Refusal(
   577	            "network-down",
   578	            f"could not read main from {remote!r}: {cloned.stderr.strip() or 'no stderr'}",
   579	            "Resubmit once the remote is reachable; this failure is safe to retry.",
   580	        )
