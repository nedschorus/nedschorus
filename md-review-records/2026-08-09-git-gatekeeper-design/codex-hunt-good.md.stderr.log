   564	def prepare_clone(workspace: Path, remote: str) -> Path:
   565	    """Clone main into the program's own workspace — never the agent's worktree.
   566	
   567	    Unchanged files come from main, so a stale working copy cannot smuggle old
   568	    content into the candidate: the candidate is built FROM the declaration.
   569	    """
