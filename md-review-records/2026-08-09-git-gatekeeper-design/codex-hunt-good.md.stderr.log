   546	
   547	def resolve_remote(repository: Path, argument: str | None) -> str:
   548	    """D1: the remote defaults to the invoking repository's origin.
   549	
   550	    Taking it as an argument is what lets a test hand the program a throwaway
   551	    bare repository (B3a) without any test-only path inside the program.
   552	    """
   553	    if argument:
   554	        return argument
   555	    remote = run_git(["remote", "get-url", "origin"], cwd=repository, check=False)
   556	    if remote.returncode != 0 or not remote.stdout.strip():
   557	        raise Refusal(
   558	            "malformed-field", "the repository has no 'origin' remote",
   559	            "Resubmit with --remote <url> naming where main lives.",
   560	        )
   561	    return remote.stdout.strip()
