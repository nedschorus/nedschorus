   618	def build_candidate(
   619	    clone: Path, request: dict, worktree: dict[str, bytes | None], digest: str,
   620	    target: str | None = None,
   621	) -> str:
   622	    """Start from main at `target` and apply exactly what was declared.
   623	
   624	    `target` is the declared base on the first attempt, and the newer main tip
   625	    on each integration round. Either way the candidate is built FROM the
   626	    declaration, so an undeclared edit can never reach it.
   627	    """
