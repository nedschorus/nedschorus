   512	def trailer_block(request: dict, digest: str) -> str:
   513	    """Three facts, a writer, and a pointer; nothing else.
   514	
   515	    The issue value is written in #<n> form deliberately: any commit reaching
   516	    the default branch with #<n> in its message appears in that issue's GitHub
   517	    timeline, so an issue collects all its check-ins with zero machinery.
   518	    """
