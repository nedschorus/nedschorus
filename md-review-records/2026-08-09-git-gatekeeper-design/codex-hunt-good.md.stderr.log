   605	def find_existing_check_in(clone: Path, digest: str, ref: str | None = None) -> str | None:
   606	    """The digest screen: work that already went through is never redone."""
   607	    found = run_git(
   608	        ["log", ref or f"origin/{MAIN_BRANCH}", "--format=%H",
   609	         "--grep", f"Gatekeeper-digest: {digest}"],
   610	        cwd=clone, check=False,
