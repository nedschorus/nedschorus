   532	def resolve_repository(argument: str | None) -> Path:
   533	    start = Path(argument).resolve() if argument else Path.cwd()
   534	    toplevel = subprocess.run(
   535	        ["git", "-C", str(start), "rev-parse", "--show-toplevel"],
   536	        capture_output=True, text=True, check=False,
   537	    )
   538	    if toplevel.returncode != 0:
   539	        raise Refusal(
   540	            "malformed-field", f"{str(start)!r} is not inside a git repository",
   541	            "Run the gatekeeper from inside the repository holding the work, or pass "
   542	            "--repo <dir> naming it.",
   543	        )
   544	    return Path(toplevel.stdout.strip())
