   521	        f"Gatekeeper-origin: {request['origin']}",
   522	        f"Gatekeeper-agent: {request['agent']}",
   523	        f"Gatekeeper-digest: {digest}",
   524	        f"Gatekeeper-import: {import_record(request['import'])}",
   525	        f"Gatekeeper-issue: {issue}",
   526	    ])
