   910	
   911	def build_parser() -> argparse.ArgumentParser:
   912	    parser = argparse.ArgumentParser(
   913	        prog="git-gatekeeper.py", description="The single check-in gate for nedschorus.",
   914	    )
   915	    commands = parser.add_subparsers(dest="command", required=True)
   916	
   917	    check = commands.add_parser("check-in", help="check work in to main")
   918	    check.add_argument("--files", nargs="+", required=True, metavar="PATH")
   919	    check.add_argument("--message", required=True)
   920	    check.add_argument("--base", required=True, metavar="COMMIT")
   921	    check.add_argument("--import", dest="import_declaration", default=None, metavar="none",
   922	                       help="'none', or omit and give the three --import-* parts")
   923	    check.add_argument("--import-commit", default=None, metavar="COMMIT")
   924	    check.add_argument("--import-source", default=None, metavar="PATH")
   925	    check.add_argument("--import-dest", default=None, metavar="PATH")
   926	    check.add_argument("--legacy-repo", default=str(Path.home() / "Projects" / "nedlern"),
   927	                       help="the legacy repository an import reads from")
   928	    check.add_argument("--issue", required=True, metavar="none|N")
   929	    check.add_argument("--agent", required=True, metavar="RUNTIME/MODEL")
   930	    check.add_argument("--repo", default=None, help="the repository holding the work")
   931	    check.add_argument("--remote", default=None, help="where main lives; defaults to origin")
   932	    mode = check.add_mutually_exclusive_group()
   933	    mode.add_argument("--wait", dest="no_wait", action="store_false", default=False)
   934	    mode.add_argument("--no-wait", dest="no_wait", action="store_true")
   935	
   936	    for name in ("status", "cancel"):
   937	        later = commands.add_parser(name, help=f"{name} a request (slice 4)")
   938	        later.add_argument("digest", nargs="?", default=None)
   939	
   940	    table = commands.add_parser("imports", help="print the legacy import table")
   941	    table.add_argument("--repo", default=None, help="the repository to read history from")
   942	    table.add_argument("--remote", default=None, help="where main lives; defaults to origin")
   943	
   944	    return parser
   945	
   946	
   947	def main(argv: list[str] | None = None) -> int:
   948	    parser = build_parser()
   949	    arguments = parser.parse_args(argv)
   950	    try:
   951	        if arguments.command == "check-in":
   952	            return check_in(arguments)
   953	        if arguments.command == "imports":
   954	            return imports_table(arguments)
   955	        return unbuilt_command(arguments.command, 4)
   956	    except Refusal as refusal:
   957	        return emit({
