     1	#!/usr/bin/env python3
     2	"""Run a full md-review grid against a document.
     3	
     4	One invocation = one review: eight cells ({restate, defect-hunt} x
     5	{good, floor} x {claude, codex}) launched in parallel, every report saved
     6	into a dated record directory, progress and next-step instructions printed
     7	for the reviewing agent as reviews land.
     8	
     9	Usage:
    10	  scripts/md-review-grid.py --target docs/drafts/foo.md
    11	
    12	Exit codes: 0 all cells ran, 1 one or more cells failed, 2 bad invocation.
    13	"""
    14	
    15	import argparse
    16	import datetime
    17	import pathlib
    18	import re
    19	import subprocess
    20	import sys
    21	import time
    22	
    23	REPO_ROOT = pathlib.Path(__file__).resolve().parent.parent
    24	RECORDS_DIR = REPO_ROOT / "md-review-records"
    25	# Cell launchers, one per runtime.
    26	CELL_LAUNCHERS = {
    27	    "claude": REPO_ROOT / "scripts" / "md-review-claude-cell.py",
    28	    "codex": REPO_ROOT / "scripts" / "md-review-codex-cell.py",
    29	}
    30	PASSES = ["restate", "defect-hunt"]
    31	TIERS = ["good", "floor"]
    32	
    33	COMPLETION_INSTRUCTIONS = """\
    34	All eight reviews are complete, in {record_dir}, one file per reviewer.
    35	
    36	Read every report in full. The restate reports show what a reader took each
    37	sentence to mean — compare them against what you intended; a confident
    38	misreading is a defect in the file, not in the reader. The defect-hunt
    39	reports flag defects with each reviewer's own confidence; expect heavy
    40	overlap — the same defect found independently by several reviewers is one
    41	defect.
    42	
    43	Keep your judgments provisional until you have read all eight, as later
    44	reports may offer more insight than earlier ones. Then formulate your draft
    45	response: which problems are real, and what you propose to do about each.
    46	Walk that with the user using the walk-me-through skill, ordered from most
    47	important to least. The walk's anchor is {record_dir}/dispositions.md."""
    48	
    49	
    50	def make_record_dir(target: pathlib.Path) -> pathlib.Path:
    51	    date = datetime.date.today().isoformat()
    52	    base = f"{date}-{target.stem}"
    53	    record_dir = RECORDS_DIR / base
    54	    suffix = 2
    55	    while record_dir.exists():
    56	        record_dir = RECORDS_DIR / f"{base}-{suffix}"
    57	        suffix += 1
    58	    record_dir.mkdir(parents=True)
    59	    return record_dir
    60	
    61	
    62	def reference_integrity_pre_pass(target: pathlib.Path, record_dir: pathlib.Path) -> None:
    63	    """Cheap grounding check: every path-like reference in the target either
    64	    resolves (relative to the repo root or the target's directory) or is
    65	    listed as unresolved. Result saved into the record for the reviewing
    66	    agent; unresolved references are leads, not verdicts."""
    67	    text = target.read_text(encoding="utf-8")
    68	    candidates = sorted(set(re.findall(
    69	        r"[\w./-]+/[\w./-]+|[\w-]+\.(?:md|py|sh|json|yaml|toml)", text)))
    70	    lines = ["# Reference-integrity pre-pass", ""]
    71	    for candidate in candidates:
    72	        clean = candidate.strip(".,;:")
    73	        resolved = (REPO_ROOT / clean).exists() or (target.parent / clean).exists()
    74	        lines.append(f"- {'ok' if resolved else 'UNRESOLVED'}: `{clean}`")
    75	    if not candidates:
    76	        lines.append("- no path-like references found")
    77	    (record_dir / "reference-check.md").write_text("\n".join(lines) + "\n", encoding="utf-8")
    78	
    79	
    80	def launch_cells(target: pathlib.Path, record_dir: pathlib.Path) -> dict:
    81	    """Start all eight cells in parallel. Returns {report_path: (process,
    82	    stderr_path)}. The parent's file handles are closed right after each
    83	    spawn; the child keeps its own copies, so a with-block is the wrong
    84	    shape here."""
    85	    running = {}
    86	    for runtime, launcher in CELL_LAUNCHERS.items():
    87	        for cell_pass in PASSES:
    88	            for tier in TIERS:
    89	                pass_token = "hunt" if cell_pass == "defect-hunt" else cell_pass
    90	                report_path = record_dir / f"{runtime}-{pass_token}-{tier}.md"
    91	                stderr_path = record_dir / (report_path.name + ".stderr.log")
    92	                out = open(report_path, "w", encoding="utf-8")  # pylint: disable=consider-using-with
    93	                err = open(stderr_path, "w", encoding="utf-8")  # pylint: disable=consider-using-with
    94	                process = subprocess.Popen(  # pylint: disable=consider-using-with
    95	                    [str(launcher), "--cell", cell_pass, "--tier", tier,
    96	                     "--target", str(target)],
    97	                    stdout=out, stderr=err, stdin=subprocess.DEVNULL,
    98	                )
    99	                out.close()
   100	                err.close()
   101	                running[report_path] = (process, stderr_path)
   102	    return running
   103	
   104	
   105	def wait_for_cells(running: dict) -> list:
   106	    """Poll until every cell finishes; print per-report progress; return the
   107	    list of failed report names."""
   108	    failures = []
   109	    while running:
   110	        time.sleep(5)
   111	        for report_path in list(running):
   112	            process, stderr_path = running[report_path]
   113	            code = process.poll()
   114	            if code is None:
   115	                continue
   116	            del running[report_path]
   117	            if code == 0:
   118	                stderr_path.unlink(missing_ok=True)
   119	                print(f"saved: {report_path}", flush=True)
   120	                continue
   121	            failures.append(report_path.name)
   122	            hint = ""
   123	            stderr_tail = stderr_path.read_text(encoding="utf-8")[-2000:]
   124	            if "401" in stderr_tail or "Not logged in" in stderr_tail:
   125	                hint = " — the runtime is logged out; ask the user to log in, then rerun this cell"
   126	            print(f"FAILED (exit {code}): {report_path.name}{hint} "
   127	                  f"(stderr kept: {stderr_path})", flush=True)
   128	    return failures
   129	
   130	
   131	def main() -> int:
   132	    parser = argparse.ArgumentParser(
   133	        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
   134	    )
   135	    parser.add_argument(
   136	        "--target", required=True, help="document path, relative to the repo root or absolute"
   137	    )
   138	    args = parser.parse_args()
   139	
   140	    target = pathlib.Path(args.target)
   141	    if not target.is_absolute():
   142	        target = REPO_ROOT / target
   143	    if not target.is_file():
   144	        print(f"md-review-grid: target not found: {target}", file=sys.stderr)
   145	        return 2
   146	    for runtime, launcher in CELL_LAUNCHERS.items():
   147	        if not launcher.is_file():
   148	            print(f"md-review-grid: {runtime} cell launcher missing: {launcher}", file=sys.stderr)
   149	            return 2
   150	
   151	    record_dir = make_record_dir(target)
   152	    reference_integrity_pre_pass(target, record_dir)
   153	
   154	    print(f"Launched eight reviewers against {target}. Reports appear in "
   155	          f"{record_dir} as each completes — read each as it arrives.")
   156	
   157	    failures = wait_for_cells(launch_cells(target, record_dir))
   158	
   159	    print()
   160	    print(COMPLETION_INSTRUCTIONS.format(record_dir=record_dir))
   161	    if failures:
   162	        print(f"\nNOTE: {len(failures)} review(s) failed and are absent from the "
   163	              f"record: {', '.join(failures)}. Rerun them singly with the cell "
   164	              f"launchers before triage, or note their absence in dispositions.md.")
   165	    return 1 if failures else 0
   166	
   167	
   168	if __name__ == "__main__":
   169	    sys.exit(main())

