#!/bin/sh
# open-iterm-window-running-command <command...> — open a new iTerm2 window on
# this Mac running the given command.
#
# The command is passed as the new session's own process (iTerm's AppleScript
# `command` parameter), never typed as keystrokes: AppleScript `write text`
# races the user's real cursor and spliced a command on 2026-08-17 — the rule
# and both incidents are recorded on nedschorus#27, and the project's
# synthetic-keystroke guard hook blocks the `write text` form outright.
#
# Argument handling (PR #82 review, F11): one argument is the command string,
# handed over whole. Several arguments are joined with single spaces, which
# only preserves meaning while no argument itself contains whitespace or
# quotes — `open-iterm-window-running-command ssh -t ned tmux attach` joins
# faithfully, but an argument like "seat a" would silently become two words.
# That form, and any raw newline (an AppleScript string cannot hold one), is
# refused with guidance instead of guessed at.
#
# THE COMMAND RUNS UNDER A LOGIN SHELL, and must, because iTerm2 gives a
# custom command a bare PATH — measured on this Mac 2026-09-02:
#
#   PATH=/usr/bin:/bin:/usr/sbin:/sbin:/Applications/iTerm.app/Contents/Resources/utilities
#
# Neither Homebrew (/opt/homebrew/bin) nor ~/.local/bin is on it, so `tmux`
# and `claude` are both NOT FOUND, and the working directory is /. That is
# not a theoretical gap: it is how this script failed on 2026-09-02 while
# reopening the seat windows after the machine's first reboot in months.
# launch-claude-mac opens with `command -v tmux || exit 1`, so each window
# died before printing a line and iTerm reported only "A session ended very
# soon after starting" — the caller is told nothing about PATH, and the
# evidence closes with the window. Three windows were lost that way.
#
# The wrapper is `<login shell> -l -c 'exec "$@"' <this script's name> <command...>`.
# The point of the `exec "$@"` form, rather than handing the command to the
# shell as a string to parse, is that IT CHANGES NOTHING ABOUT THE COMMAND.
# The shell reads the login files (which is the whole purpose), then execs
# the argument vector iTerm already built, verbatim. Measured the same day,
# through the real iTerm2:
#
#   - `-t 'seat a'` still arrives as ONE argument, as it did before;
#   - `lit$HOME` still arrives LITERAL — no expansion layer is added;
#   - and tmux resolves to /opt/homebrew/bin/tmux, which is the fix.
#
# Handing the shell a command STRING instead would have added a second round
# of shell interpretation to every caller's command, and there is no safe way
# to quote against it here: iTerm2's own parser consumes one level of quoting
# and does NOT implement the POSIX '\'' escape (measured — that form parses
# to nothing and the window dies), so a command containing a single quote
# could not be re-quoted for the wrapper at all.
#
# WHAT IS NOT A SHELL LINE. iTerm2 splits the command string into an argument
# vector and execs it; it does not run it through a shell. So `;` is not a
# separator and `$HOME` is not expanded — both arrive as literal words (also
# measured 2026-09-02; this comment previously advised `;` as a separator,
# which never worked). To run several commands, pass a shell explicitly and
# quote its script: `open-iterm-window-running-command "sh -c 'a; b'"`.
#
# OPEN_ITERM_WINDOW_DRY_RUN=1 prints the generated AppleScript instead of
# running it: the seam the test file uses, so no test opens a real window.
#
# The window closes when the command exits (iTerm profile default); for a
# window that should persist, run an interactive process (e.g. ssh -t, tmux
# attach) as the command.

set -eu

if [ $# -lt 1 ]; then
    echo "usage: open-iterm-window-running-command <command...>" >&2
    echo "Opens an iTerm2 window running the command — passed as the session's" >&2
    echo "process, never as synthetic keystrokes (rule: nedschorus#27)." >&2
    exit 2
fi

if [ $# -gt 1 ]; then
    for ARGUMENT in "$@"; do
        case $ARGUMENT in
            *[[:space:]]* | *\'* | *\"*)
                echo "open-iterm-window-running-command: refusing to join multiple arguments when one contains whitespace or quotes — the join would silently change the command's word boundaries (PR #82 review, F11). Pass the whole command as one quoted argument instead." >&2
                exit 2
                ;;
        esac
    done
fi

COMMAND_TEXT=$*

NEWLINE='
'
case $COMMAND_TEXT in
    *"$NEWLINE"*)
        echo "open-iterm-window-running-command: the command may not contain a raw newline (an AppleScript string cannot hold one). The command is an argument vector, not a shell line, so a bare ';' is a literal word — pass a shell explicitly and quote its script instead: \"sh -c 'first; second'\"." >&2
        exit 2
        ;;
esac

if [ "${OPEN_ITERM_WINDOW_DRY_RUN:-}" != "1" ] && ! command -v osascript >/dev/null 2>&1; then
    echo "open-iterm-window-running-command: needs macOS (osascript not found)" >&2
    exit 1
fi

# The login shell to wrap the command in — see THE COMMAND RUNS UNDER A LOGIN
# SHELL above. $SHELL is the user's own, so the window gets the PATH that user
# would have in a terminal; /bin/sh is the fallback when it is unset, and also
# when it holds anything that iTerm2's word-splitting would not deliver as a
# single word, since this value is spliced into the command string it parses.
#
# It must also be a shell of the POSIX family, and that is not a formality:
# /bin/csh and /bin/tcsh are in this Mac's /etc/shells, and both reject `-l`
# and have no `exec "$@"` — a window opened under one would die instantly with
# nothing said, which is the exact failure this wrapper exists to end (external
# review of this change, 2026-09-02, P2). The named shells below are the ones
# whose `-l -c 'exec "$@"'` form is POSIX; anything else falls back rather than
# being guessed at.
#
# THE FALLBACK IS ANNOUNCED, because /bin/sh does not read another shell's
# login files: a fish or csh user whose PATH is set in ~/.config/fish or
# ~/.cshrc gets /bin/sh's PATH, which may still not hold what they asked to
# run (second external review round of this change, 2026-09-02, P2). The
# window then dies the original way. Nobody in this fleet runs such a shell —
# $SHELL is /bin/zsh on this Mac — so supporting their syntax would be
# building for a configuration that does not exist here; what is worth having
# is that the substitution is never silent, since a silent one recreates
# exactly the "died and said nothing" failure this wrapper was written to end.
LOGIN_SHELL=${SHELL:-/bin/sh}
FALLBACK_REASON=
case $LOGIN_SHELL in
    /*) ;;
    *) FALLBACK_REASON="it is not an absolute path" ;;
esac
if [ -z "$FALLBACK_REASON" ]; then
    case $LOGIN_SHELL in
        *[[:space:]]* | *\'* | *\"*)
            FALLBACK_REASON="it contains whitespace or quotes, which iTerm2's word-splitting would not deliver as one word"
            ;;
    esac
fi
if [ -z "$FALLBACK_REASON" ]; then
    case ${LOGIN_SHELL##*/} in
        sh | bash | zsh | dash | ksh | ksh93 | mksh) ;;
        *)
            FALLBACK_REASON="it is not a POSIX-family shell, so it has no '-l -c \"exec \\\$@\"' form"
            ;;
    esac
fi
if [ -n "$FALLBACK_REASON" ]; then
    echo "open-iterm-window-running-command: not using \$SHELL ($LOGIN_SHELL) — $FALLBACK_REASON. Falling back to /bin/sh -l, which does NOT read that shell's login files, so anything on PATH only through them will still not be found." >&2
    LOGIN_SHELL=/bin/sh
fi

# `exec "$@"` is a fixed script, not the caller's text: the shell reads its
# login files and then execs iTerm's argument vector unchanged. The word after
# it is the shell's $0, which names this tool in anything the shell reports
# (a "command not found" names the opener, not a bare "zsh").
WRAPPED_COMMAND="$LOGIN_SHELL -l -c 'exec \"\$@\"' open-iterm-window-running-command $COMMAND_TEXT"

# Escape for embedding in an AppleScript double-quoted string.
ESCAPED=$(printf '%s' "$WRAPPED_COMMAND" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')

APPLESCRIPT="tell application \"iTerm\"
	create window with default profile command \"$ESCAPED\"
end tell"

if [ "${OPEN_ITERM_WINDOW_DRY_RUN:-}" = "1" ]; then
    printf '%s\n' "$APPLESCRIPT"
    exit 0
fi

printf '%s\n' "$APPLESCRIPT" | osascript -
