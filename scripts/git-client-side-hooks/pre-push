#!/bin/sh
# Refuses a push from a mutation-testing worktree, a push that rewrites or
# deletes the head branch of an open pull request, and a push of a branch that
# conflicts with main or sets a file back to a version main has replaced; lets
# every other push through. It runs no test suites: the author runs them before
# pushing, and merge-lane-2 runs them at the pull request's head. The work is
# done by three Python files,
# scripts/git-client-side-hooks-pre-push-mutation-testing-worktree-push-refusal.py,
# scripts/git-client-side-hooks-pre-push-open-pull-request-branch-non-fast-forward-or-deletion-refusal.py and
# scripts/git-client-side-hooks-pre-push-conflict-check.py, whose docstrings
# have the reasons and what is and is not checked. This file only guards the way
# into them.
#
# Installed by the same per-clone core.hooksPath as prepare-commit-msg, an
# absolute path into the clone's reference checkout, which stays on main, so
# every seat's worktree runs main's copy:
#   Mac:      /Users/el/Projects/nedschorus/scripts/git-client-side-hooks
#   ned-box:  /home/nedlern/Projects/nedschorus/scripts/git-client-side-hooks
# (both set in the clone's own .git/config, not globally).
#
# A pre-push hook that exits non-zero stops the push, and this one runs on
# every push from every seat on the machine. So it fails open: it exits 1
# only when a Python file asks for a refusal with its own status, 10, and
# 0 on everything else. That includes python3 missing from PATH, which the
# shell reports as status 127, a Python file missing, and a Python file
# failing, whatever its status. The file
# is written in sh rather than Python because a hook whose `#!` names a
# missing interpreter makes git stop every push.
#
# The pushed refs are read once, into a variable, so the messages below can
# name each branch the conflict check would have checked, and so a push with
# no such branch (main, a tag, a deletion, another remote) does not run the
# conflict check. Such a push still runs the open
# pull request check, which asks GitHub about a forced update or a deletion of
# a branch on origin.
# The filter matches branches_to_check in the Python file; the pre-push nc-test-suite
# pins both against the same pushes.

hook_directory=$(dirname "$0")
conflict_check="$hook_directory/../git-client-side-hooks-pre-push-conflict-check.py"
# Resolved, so a message names the file by a path a reader can open.
scripts_directory=$(cd "$hook_directory/.." 2>/dev/null && pwd -P) || scripts_directory="$hook_directory/.."
mutation_testing_worktree_check="$scripts_directory/git-client-side-hooks-pre-push-mutation-testing-worktree-push-refusal.py"
open_pull_request_branch_check="$scripts_directory/git-client-side-hooks-pre-push-open-pull-request-branch-non-fast-forward-or-deletion-refusal.py"
refuse_push_status=10
checked_remote=origin
tell_user_line="Tell the user this whole message, including any error printed just above it: the next push on this machine may go unchecked the same way."

pushed_refs=$(cat)
remote_name=$1
remote_url=$2

branch_list=""
unchecked_lines=""
revert_lines=""
if [ "$remote_name" = "$checked_remote" ]; then
    newline='
'
    old_ifs=$IFS
    IFS=$newline
    set -f
    for ref_line in $pushed_refs; do
        IFS=$old_ifs
        # shellcheck disable=SC2086
        set -- $ref_line
        IFS=$newline
        [ "$#" -eq 4 ] || continue
        local_object_id=$2
        remote_ref=$3
        case "$local_object_id" in
            *[!0]*) ;;
            *) continue ;;
        esac
        case "$remote_ref" in
            refs/heads/main) continue ;;
            refs/heads/*) ;;
            *) continue ;;
        esac
        branch=${remote_ref#refs/heads/}
        commit=$(printf '%.12s' "$local_object_id")
        if [ -n "$branch_list" ]; then
            branch_list="$branch_list, "
        fi
        branch_list="$branch_list$branch ($commit)"
        unchecked_lines="${unchecked_lines}Check $branch by hand from your worktree: python3 scripts/branch-conflict-check.py --head $commit$newline"
        revert_lines="${revert_lines}Once the hand conflict check of $branch prints VERDICT: CLEAN, check it for files set back too: python3 scripts/branch-reverts-a-file-to-an-older-main-version-check.py --head $commit$newline"
    done
    set +f
    IFS=$old_ifs
    set -- "$remote_name" "$remote_url"
fi

# Every push goes to this check, since a push from a mutation-testing worktree is refused
# whatever it pushes. It fails open, as the conflict check below does.
if [ -f "$mutation_testing_worktree_check" ]; then
    printf '%s\n' "$pushed_refs" | python3 "$mutation_testing_worktree_check" "$@"
    mutation_testing_worktree_status=$?
    if [ "$mutation_testing_worktree_status" -eq "$refuse_push_status" ]; then
        exit 1
    fi
    if [ "$mutation_testing_worktree_status" -ne 0 ]; then
        echo "pre-push: the check for mutation-testing worktrees, $mutation_testing_worktree_check, exited with status $mutation_testing_worktree_status, so this check lets the push through without checking whether it comes from a mutation-testing worktree." >&2
        echo "$tell_user_line" >&2
    fi
else
    echo "pre-push: the check for mutation-testing worktrees did not run, because $mutation_testing_worktree_check is missing, so this check lets the push through without checking whether it comes from a mutation-testing worktree." >&2
    echo "$tell_user_line" >&2
fi

# Every push goes to this check too, since the branch filter above leaves out deletions and
# main, which this check covers. It fails open, as the checks before and after it do.
if [ -f "$open_pull_request_branch_check" ]; then
    printf '%s\n' "$pushed_refs" | python3 "$open_pull_request_branch_check" "$@"
    open_pull_request_branch_status=$?
    if [ "$open_pull_request_branch_status" -eq "$refuse_push_status" ]; then
        exit 1
    fi
    if [ "$open_pull_request_branch_status" -ne 0 ]; then
        echo "pre-push: the check for rewrites and deletions of open pull requests' head branches, $open_pull_request_branch_check, exited with status $open_pull_request_branch_status, so this check lets the push through without checking whether it rewrites or deletes the head branch of an open pull request." >&2
        echo "$tell_user_line" >&2
    fi
else
    echo "pre-push: the check for rewrites and deletions of open pull requests' head branches did not run, because $open_pull_request_branch_check is missing, so this check lets the push through without checking whether it rewrites or deletes the head branch of an open pull request." >&2
    echo "$tell_user_line" >&2
fi

[ -n "$branch_list" ] || exit 0

say_no_branch_checked() {
    echo "pre-push: $1, so none of this push's branches was checked for conflicts with origin/main: $branch_list." >&2
    printf '%s' "$unchecked_lines" >&2
    echo "Nor was any of them checked for files set back to a version that origin/main has replaced, because that check runs only on a branch the conflict check finds clean." >&2
    printf '%s' "$revert_lines" >&2
    echo "pre-push: neither the conflict check nor the revert check refuses this push, so it goes through." >&2
    echo "$tell_user_line" >&2
}

if [ -f "$conflict_check" ]; then
    printf '%s\n' "$pushed_refs" | python3 "$conflict_check" "$@"
    conflict_check_status=$?
    if [ "$conflict_check_status" -eq "$refuse_push_status" ]; then
        exit 1
    fi
    if [ "$conflict_check_status" -ne 0 ]; then
        say_no_branch_checked "the pre-push conflict check exited with status $conflict_check_status"
    fi
else
    say_no_branch_checked "the pre-push conflict check did not run, because $conflict_check is missing"
fi
exit 0
