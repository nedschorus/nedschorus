#!/bin/sh
# Refuses a push from a mutation-testing worktree, a push that loses a test case main
# has without a commit message naming it, and a push of a branch that conflicts
# with main; lets every other push through. The work is done by two Python files,
# scripts/git-client-side-hooks-pre-push-refusal-of-lost-test-cases-and-of-pushes-from-mutation-testing-worktrees.py
# and scripts/git-client-side-hooks-pre-push-conflict-check.py, whose docstrings
# have the reasons and what is and is not checked. This file only guards the way
# into them.
#
# Installed by the same per-clone core.hooksPath as prepare-commit-msg, an
# absolute path into the clone's reference checkout, which stays on main, so
# every seat's worktree runs main's copy:
#   Mac:      /Users/el/Projects/nedschorus/scripts/git-client-side-hooks
#   ned-box:  /home/nedlern/Projects/nedschorus/scripts/git-client-side-hooks
# (both set in the clone's own .git/config, not globally; checked 2026-09-23).
#
# A pre-push hook that exits non-zero stops the push, and this one runs on
# every push from every seat on the machine. So it fails open: it exits 1
# only when the Python file asks for a refusal with its own status, 10, and
# 0 on everything else. That includes python3 missing from PATH, which the
# shell reports as status 127, the Python file missing, and the Python file
# failing, whatever its status. The file
# is written in sh rather than Python because a hook whose `#!` names a
# missing interpreter makes git stop every push.
#
# The pushed refs are read once, into a variable, so the messages below can
# name each branch the conflict check would have checked, and so a push with
# no such branch (main, a tag, a deletion, another remote) prints nothing.
# The filter matches branches_to_check in the Python file; the pre-push test
# suite pins both against the same pushes.

hook_directory=$(dirname "$0")
conflict_check="$hook_directory/../git-client-side-hooks-pre-push-conflict-check.py"
lost_case_and_copy_check="$hook_directory/../git-client-side-hooks-pre-push-refusal-of-lost-test-cases-and-of-pushes-from-mutation-testing-worktrees.py"
refuse_push_status=10
checked_remote=origin
tell_user_line="Tell the user this whole message, including any error printed just above it: the next push on this machine may go unchecked the same way."

pushed_refs=$(cat)
remote_name=$1
remote_url=$2

branch_list=""
unchecked_lines=""
if [ "$remote_name" = "$checked_remote" ]; then
    newline='
'
    old_ifs=$IFS
    IFS=$newline
    set -f
    for ref_line in $pushed_refs; do
        IFS=$old_ifs
        # shellcheck disable=SC2086
        set -- $ref_line
        IFS=$newline
        [ "$#" -eq 4 ] || continue
        local_object_id=$2
        remote_ref=$3
        case "$local_object_id" in
            *[!0]*) ;;
            *) continue ;;
        esac
        case "$remote_ref" in
            refs/heads/main) continue ;;
            refs/heads/*) ;;
            *) continue ;;
        esac
        branch=${remote_ref#refs/heads/}
        commit=$(printf '%.12s' "$local_object_id")
        if [ -n "$branch_list" ]; then
            branch_list="$branch_list, "
        fi
        branch_list="$branch_list$branch ($commit)"
        unchecked_lines="${unchecked_lines}Check $branch by hand from your worktree: python3 scripts/branch-conflict-check.py --head $commit$newline"
    done
    set +f
    IFS=$old_ifs
    set -- "$remote_name" "$remote_url"
fi

# Every push goes to this check, since a push from a mutation-testing worktree is refused
# whatever it pushes. It fails open, as the conflict check below does.
if [ -f "$lost_case_and_copy_check" ]; then
    printf '%s\n' "$pushed_refs" | python3 "$lost_case_and_copy_check" "$@"
    lost_case_and_copy_status=$?
    if [ "$lost_case_and_copy_status" -eq "$refuse_push_status" ]; then
        exit 1
    fi
    if [ "$lost_case_and_copy_status" -ne 0 ]; then
        echo "pre-push: the check for lost test cases and mutation-testing worktrees, $lost_case_and_copy_check, exited with status $lost_case_and_copy_status, so this push was not checked for either." >&2
        echo "$tell_user_line" >&2
    fi
else
    echo "pre-push: the check for lost test cases and mutation-testing worktrees did not run, because $lost_case_and_copy_check is missing, so this push was not checked for either." >&2
    echo "$tell_user_line" >&2
fi

[ -n "$branch_list" ] || exit 0

say_no_branch_checked() {
    echo "pre-push: $1, so no branch in this push was checked for conflicts with origin/main: $branch_list." >&2
    printf '%s' "$unchecked_lines" >&2
    echo "$tell_user_line" >&2
}

if [ ! -f "$conflict_check" ]; then
    say_no_branch_checked "the pre-push conflict check did not run, because $conflict_check is missing"
    exit 0
fi

printf '%s\n' "$pushed_refs" | python3 "$conflict_check" "$@"
conflict_check_status=$?
if [ "$conflict_check_status" -eq "$refuse_push_status" ]; then
    exit 1
fi
if [ "$conflict_check_status" -ne 0 ]; then
    say_no_branch_checked "the pre-push conflict check exited with status $conflict_check_status"
fi
exit 0
