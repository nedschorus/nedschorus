#!/bin/sh
# Stamps a session trailer on every commit made inside a Claude session that
# the harness has identified, preferring the claude.ai link and falling back
# to the session id.
#
# The harness asks a session that has a link to end its commit messages with
#   Claude-Session: https://claude.ai/code/<session id>
# and puts that id in CLAUDE_CODE_BRIDGE_SESSION_ID. Agents forget the line,
# so git adds it, and nobody has to remember.
#
# A session with no link gets its session id instead (see the selection
# below), so that its commits stay traceable. Only a session the harness
# identifies by neither variable goes unstamped.
#
# addIfDifferent: a message that already carries this session's line keeps
# exactly one; a commit re-made by another session (amend, cherry-pick,
# rebase) keeps the first session's line and gains its own beneath it.
#
# Installed once per clone, as an absolute path into the clone's reference
# checkout, which stays on main, so every seat's worktree runs main's copy:
#   Mac:      git config core.hooksPath /Users/el/Projects/nedschorus/scripts/git-client-side-hooks
#   ned-box:  git config core.hooksPath /home/nedlern/Projects/nedschorus/scripts/git-client-side-hooks
#
# A prepare-commit-msg hook that exits non-zero aborts the commit, and this
# one runs on every commit of every seat on the machine, so it always exits 0.
# A failed stamp is reported on stderr, never fatal.

# Two variables, and the linked one is preferred. The harness gives a session
# that has a claude.ai link CLAUDE_CODE_BRIDGE_SESSION_ID, and gives every
# session CLAUDE_CODE_SESSION_ID, which names its transcript on the authoring
# machine at ~/.claude/projects/<slugged working directory>/<id>.jsonl. A
# session without a link has only the second; without a trailer, a reviewer
# must reconstruct a commit's authoring session from its content, and can
# mistake the missing trailer for an unwired core.hooksPath. The linked form stays first
# because a reviewer can open it; the id is the fallback because a reviewer
# can still find the transcript from it.
#
# Which sessions lack the link is not known and is not this hook's business:
# it keys on the variables it is given, never on a kind of session. An
# earlier draft of this comment offered a child session as the example and
# was wrong — an independent reviewer of the pull request that added the
# fallback was itself a child session, CLAUDE_CODE_CHILD_SESSION=1, and had
# both variables.
bridge_session_id="$CLAUDE_CODE_BRIDGE_SESSION_ID"
local_session_id="$CLAUDE_CODE_SESSION_ID"
if [ -n "$bridge_session_id" ]; then
    session_trailer="Claude-Session: https://claude.ai/code/$bridge_session_id"
elif [ -n "$local_session_id" ]; then
    session_trailer="Claude-Session-Id: $local_session_id"
else
    exit 0
fi

# git refuses an empty message ("Aborting commit due to empty commit message"),
# and the trailer must not turn an empty message into one that goes through:
# a file with nothing but comment lines and whitespace is left untouched.
# A missing file is left for interpret-trailers to report.
say_trailer_may_be_missing() {
    echo "prepare-commit-msg: $1, so the trailer \"$session_trailer\" may be missing from this commit's message; the trailer is how a reviewer finds the agent-session that made a commit. $2's error is just above this line." >&2
    echo "If this commit was made by a rebase, merge or cherry-pick, leave the commits as they are, and tell the user this message once the operation is done." >&2
    echo "Otherwise, if git log -1 shows the commit you just made, that commit is not pushed, and its message lacks the trailer, add it with: git commit --amend --only --no-edit --trailer \"$session_trailer\"" >&2
    echo "If that amend fails, or the commit is already pushed, leave the commit as it is and tell the user this whole message." >&2
}

# git config --get exits 1 when the key is unset.
comment_char="$(git config --get core.commentChar)"
comment_char_status=$?
if [ "$comment_char_status" -ne 0 ]; then
    if [ "$comment_char_status" -ne 1 ]; then
        echo "prepare-commit-msg: git config --get core.commentChar exited with status $comment_char_status, so this hook takes '#' as the comment character when it decides whether the message is empty; git's error is just above this line." >&2
    fi
    comment_char='#'
fi
if [ -f "$1" ]; then
    # grep -v exits 1 when every line is a comment line, and 2 when it cannot read the file.
    uncommented="$(grep -v "^$comment_char" "$1")"
    uncommented_status=$?
    if [ "$uncommented_status" -gt 1 ]; then
        say_trailer_may_be_missing "grep could not read the commit message file $1 (status $uncommented_status)" grep
        exit 0
    fi
    if ! printf '%s\n' "$uncommented" | grep -q '[^[:space:]]'; then
        exit 0
    fi
fi

# --no-divider: the file is a bare commit message, never a patch, so a "---"
# line in its body is text, not the start of a diff to stamp above.
git interpret-trailers --in-place --no-divider --if-exists addIfDifferent \
    --trailer "$session_trailer" "$1" ||
    say_trailer_may_be_missing "git interpret-trailers failed" git
exit 0
