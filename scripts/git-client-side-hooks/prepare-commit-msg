#!/bin/sh
# Stamps the Claude-Session trailer on every commit made inside a Claude
# session that has a claude.ai link.
#
# The harness asks each such session to end its commit messages with
#   Claude-Session: https://claude.ai/code/<session id>
# and puts that id in CLAUDE_CODE_BRIDGE_SESSION_ID. Agents forget the line:
# all six pull requests of the reboot-test seat's 2026-09-17/18 session went
# out without it (issue "Topic-branch base enforcement", piece 3). So git adds
# it, and nobody has to remember. A session with no link has no variable and
# gets no trailer, which is the harness's own rule.
#
# addIfDifferent: a message that already carries this session's line keeps
# exactly one; a commit re-made by another session (amend, cherry-pick,
# rebase) keeps the first session's line and gains its own beneath it.
#
# Installed once per clone, as an absolute path into the clone's reference
# checkout, which stays on main, so every seat's worktree runs main's copy:
#   Mac:      git config core.hooksPath /Users/el/Projects/nedschorus/scripts/git-client-side-hooks
#   ned-box:  git config core.hooksPath /home/nedlern/Projects/nedschorus/scripts/git-client-side-hooks
#
# A prepare-commit-msg hook that exits non-zero aborts the commit, and this
# one runs on every commit of every seat on the machine, so it always exits 0.
# A failed stamp is reported on stderr, never fatal.

# Two variables, and the linked one is preferred. The harness gives a session
# that has a claude.ai link CLAUDE_CODE_BRIDGE_SESSION_ID, and gives every
# session CLAUDE_CODE_SESSION_ID, which names its transcript on the authoring
# machine at ~/.claude/projects/<slugged working directory>/<id>.jsonl. A
# session without a link — a child session, for one — has only the second, and
# until 2026-09-20 got no trailer at all: 12 of main's last 60 non-merge
# commits carried none, and a merge-lane reviewer had to reconstruct one such
# commit's authoring session from its content, then wrongly diagnosed the
# absence as an unwired core.hooksPath and told a seat to rewire it. The
# linked form stays first because a reviewer can open it; the id is the
# fallback because a reviewer can still find the transcript from it.
bridge_session_id="$CLAUDE_CODE_BRIDGE_SESSION_ID"
local_session_id="$CLAUDE_CODE_SESSION_ID"
if [ -n "$bridge_session_id" ]; then
    session_trailer="Claude-Session: https://claude.ai/code/$bridge_session_id"
elif [ -n "$local_session_id" ]; then
    session_trailer="Claude-Session-Id: $local_session_id"
else
    exit 0
fi

# git refuses an empty message ("Aborting commit due to empty commit message"),
# and the trailer must not turn an empty message into one that goes through:
# a file with nothing but comment lines and whitespace is left untouched.
# A missing file is left for interpret-trailers to report.
comment_char="$(git config --get core.commentChar || echo '#')"
if [ -f "$1" ] && ! grep -v "^$comment_char" "$1" | grep -q '[^[:space:]]'; then
    exit 0
fi

# --no-divider: the file is a bare commit message, never a patch, so a "---"
# line in its body is text, not the start of a diff to stamp above.
git interpret-trailers --in-place --no-divider --if-exists addIfDifferent \
    --trailer "$session_trailer" "$1" ||
    echo "prepare-commit-msg: could not add the session trailer; add it by hand" >&2
exit 0
