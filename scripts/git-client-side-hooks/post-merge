#!/bin/sh
# Each program does nothing outside a reference-checkout. The first restarts
# the nc-shared-database service when a merge into ned-box's reference-checkout
# changes the service; the second runs the scheduled-jobs installer with
# --install in either machine's reference-checkout, and hands a failed install
# to the agent-seat that owns the installer. Both run whatever the
# other exits, and git ignores this hook's exit code. Git passes one argument,
# whether the merge was a squash, which neither program needs.
hooks="$(dirname "$0")"
python3 "$hooks/../../nc-systems/nc-shared-database/nc-shared-database-service-restart-after-merge.py"
python3 "$hooks/../../nc-systems/general-tools/install-scheduled-jobs-on-this-machine-after-reference-checkout-merge-and-report-install-failure-as-task-for-installer-owner-agent-seat.py"
