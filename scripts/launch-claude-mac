#!/bin/sh
# launch-claude-mac <name> [--no-attach] — reach the named agent ON THIS MAC.
#
# The local twin of launch-claude-ubuntu, sharing every convention and none of
# the SSH: the name you type is the whole configuration, the agent's directory
# is $NEDSCHORUS_AGENTS_ROOT/<name> (default ~/agents/<name>), created on first
# use, and a CLAUDE.local.md in that directory supplies the agent's identity —
# without one the agent is generic and the name is just a label.
#
# Which twin to type: the Ubuntu box is the default home for agent work (more
# memory, CPU and bandwidth, and it does not compete with the user's machine).
# Use THIS script only for work that must run where the user sits — anything
# needing the Mac's browser session, its keychain, its GUI, or files that live
# only on it. The machine is in both names because the choice is a real one and
# the wrong pick is easy to make.
#
# Attach-or-create comes from tmux: `new-session -A` attaches to the session
# named <name> when it exists and creates it when it does not, so a closed
# terminal window never orphans an agent — type the same command to reconnect.
# Inside the session runs the handoff supervisor, which launches the claude
# session, reincarnates it on every handoff, and exits when its agent stops without
# handing off. On an ATTACHED launch the pane then drops into an interactive
# shell in the agent's directory (surviving a Ctrl-C aimed at the supervisor),
# so the seat can be resumed in place with `claude --continue` and no hunting
# for the right cd (user-ruled 2026-08-17) — the tmux session closes when that
# shell exits. That shell offers the SUPERVISED relaunch first and states what
# `claude --continue` costs: it resumes the dialog with no supervisor, so the
# seat can never reincarnate. The old ordering advertised --continue first, and on
# 2026-08-18 two seats ran unsupervised for about 25 hours because it was the
# only listed option that worked (nedschorus#45). A seat born with --no-attach keeps the old close-on-exit
# behavior instead, even if attached later: its pane command is fixed at
# creation. A second launch of a running name attaches instead of
# duplicating, and the supervisor holds a per-agent lock that refuses a
# second copy even if tmux is bypassed.
# Both protections are per-machine, as is every other thing an agent owns, so
# nothing stops the same name on both machines. But the name is also the
# seat's Remote Control address, which agents on the other machine send to,
# so names are unique across the whole fleet; nothing enforces that here.
#
# Every seat runs on its OWN tmux server (`tmux -L <name>`, one socket per
# seat under /tmp/tmux-<uid>/), so one server crash cannot take the whole
# per-machine fleet down: on 2026-08-21 the Mac's single default tmux server
# died and killed all three Mac seats at once. Seats launched before that
# change still live on the default server; the socket selection below reaches
# them there instead of starting a duplicate.
#
# --no-attach creates the session without attaching this terminal (for scripts
# and checks); attach later by running the plain form.
#
# Requires on this Mac: tmux, python3, and claude on the PATH.

set -eu

AGENTS_ROOT="${NEDSCHORUS_AGENTS_ROOT:-$HOME/agents}"
# A literal-tilde value (a quoted export sends one) is resolved or refused,
# never half-worked (PR #137 review P3 on the twin, user-ruled 2026-08-22:
# overrides either work or are blocked): ~/ becomes $HOME as the operator's
# shell would have made it, and every fleet Python tool already
# expanduser()s the same value; a ~user/ form is refused, because this
# script would mkdir a literal ~user directory while those tools resolve
# that user's real home — one seat, silently split across two directories.
case "$AGENTS_ROOT" in
    ("~"[!/]*)
        echo "launch-claude-mac: ~user agents roots are not supported — the shell and the fleet's Python tools resolve them to different directories, splitting the seat. Use an absolute path." >&2
        exit 2 ;;
    ("~") AGENTS_ROOT="$HOME" ;;
    ("~/"*) AGENTS_ROOT="$HOME${AGENTS_ROOT#?}" ;;
esac

# The supervisor lives in its own system directory one level up, so the
# checkout location is never configured and never wrong — wherever this
# script was run from IS the checkout it belongs to. It stopped being this
# script's sibling when the handoff system moved into nc-systems/handoff/
# on 2026-09-20.
SCRIPT_DIRECTORY=$(cd "$(dirname "$0")" && pwd)
REPOSITORY_ROOT=$(cd "$SCRIPT_DIRECTORY/.." && pwd)
SUPERVISOR="$REPOSITORY_ROOT/nc-systems/handoff/handoff-supervisor.py"

# The no-name case is the common mistake, so it teaches rather than scolds:
# what a name is for, and which agents are running right now to pick from or
# avoid colliding with.
usage() {
    echo "usage: launch-claude-mac <name> [--no-attach] [--first-prompt-file <path>]" >&2
    echo >&2
    echo "Every agent is named, and the name is the whole configuration: it names the" >&2
    echo "tmux session, the home directory ($AGENTS_ROOT/<name>), and the agent's handoff" >&2
    echo "files. Running a name that is already up ATTACHES to that agent — you cannot" >&2
    echo "start a second copy of one." >&2
    echo >&2
    # Per-seat tmux servers: one list-sessions cannot see every seat, so walk
    # every socket in tmux's socket directory — per-seat servers and the
    # default server (where pre-2026-08-21 seats still live) alike. A dead
    # socket's listing fails and is skipped.
    running=$(
        for seat_socket_path in "${TMUX_TMPDIR:-/tmp}/tmux-$(id -u)"/*; do
            [ -S "$seat_socket_path" ] || continue
            # name@socket, not the bare name: one name on TWO sockets is the
            # decoy class resupervise-seat.py kills (PR #122 review P3-5),
            # and a deduplicated listing would hide exactly that.
            tmux -S "$seat_socket_path" list-sessions -F "#{session_name}@$(basename "$seat_socket_path")" 2>/dev/null || true
        done | sort -u | tr '\n' ' ')
    if [ -n "$running" ]; then
        echo "Agent tmux sessions on this Mac now (live seats or after-exit shells): $running" >&2
    else
        echo "No agent tmux sessions on this Mac now." >&2
    fi
    echo "(Agents on the Ubuntu box are separate: launch-claude-ubuntu.)" >&2
    echo >&2
    echo "The two machines share no agent state — tmux sessions, home directories," >&2
    echo "handoff files and locks are all per-machine — but a name is also the seat's" >&2
    echo "Remote Control address, which agents on the other machine send to, so names are" >&2
    echo "unique across the whole fleet. Nothing on either machine enforces that." >&2
    exit 2
}

[ $# -ge 1 ] || usage
AGENT_NAME="$1"
shift
ATTACH=yes
FIRST_PROMPT_FILE=""
while [ $# -gt 0 ]; do
    case "$1" in
        (--no-attach) ATTACH=no; shift ;;
        (--first-prompt-file) FIRST_PROMPT_FILE="${2:?--first-prompt-file needs a path}"; shift 2 ;;
        (*) usage ;;
    esac
done
case "$AGENT_NAME" in
    (*[!a-zA-Z0-9_-]*|"") echo "launch-claude-mac: agent names are letters, digits, - and _" >&2; exit 2 ;;
esac

# Which GitHub account this seat acts as. The default is the HOST's account,
# which is the shape credential ruling C4 states — "each agent host holds a
# fine-grained token for this repository only ... never a classic
# all-repository token, and never the `workflow` scope"
# (nc-systems/main-gatekeeper/main-gatekeeper-design.md). The override exists
# for the seat whose job needs a different identity: the merge-lane seat must
# be `ned-review-merge`, which is one of the two accounts main's protection
# lets push (the other is the user's own), and which exists as a separate
# identity at all because GitHub refuses an approving review from a pull
# request's author — so the account that approves cannot be the one that
# opened it
# (docs/nedschorus-wiki/queue/github-identities-credentials-and-token-policy.md).
#
# Measured on this Mac 2026-09-22, and the defect this exists to close: `gh
# auth status` reports the login as `nedlern` — the USER — holding a CLASSIC
# token whose scopes include admin:enterprise, admin:org, admin:org_hook,
# repo, workflow and user. Every Mac seat therefore runs today with the
# owner's organization-admin credential, and every server-side record of a
# seat's writes names the user rather than the seat.
#
# The charset check is the AGENT_NAME rule above applied to the same kind of
# value for the same two reasons: the account name is spliced into the
# composed pane command, and a value validated to letters, digits, - and _
# needs no escaping at any parse it crosses; and an override either works or
# is blocked, never a third state (user-ruled 2026-08-22, the ruling this
# script already cites for NEDSCHORUS_AGENTS_ROOT). Refused here, before
# `claude update`, before any mkdir. The :- form rather than -, so an
# exported-but-empty override is the default rather than a refusal.
SEAT_GITHUB_ACCOUNT="${NEDSCHORUS_SEAT_GITHUB_ACCOUNT:-mac-claude}"
case "$SEAT_GITHUB_ACCOUNT" in
    (*[!a-zA-Z0-9_-]*|"") echo "launch-claude-mac: NEDSCHORUS_SEAT_GITHUB_ACCOUNT is a GitHub account name — letters, digits, - and _" >&2; exit 2 ;;
esac

# The override is CONSUMED here and unset before the tmux server starts, so
# the seat's process tree never inherits it — the same rule, for the same
# measured reason, as LAUNCH_CLAUDE_SUPERVISOR_EXTRA_ARGUMENTS below. That
# variable leaked on 2026-09-03: a recovered seat ran `launch-claude-mac
# <other-seat>` from its Bash tool, the launcher found the inherited value,
# and the other seat came up wrong. This one leaks worse. The merge-lane
# seat is launched with the override set to `ned-review-merge`, an account
# on main's push allow-list; without this unset, any seat merge-lane
# launched from its own Bash tool would come up on that account too — a
# second merge lane, which is the one thing a seat may not be.
unset NEDSCHORUS_SEAT_GITHUB_ACCOUNT

# Resolve Claude Code the way the SEAT will resolve it, and do it before
# anything checks for it or updates it. The supervisor command further down
# exports this same directory, so without it here the launcher can check and
# update one copy while the seat it starts runs another. Measured 2026-08-31:
# this Mac's update step reached a Homebrew-installed claude while its seats
# ran the native build at ~/.local/bin, and the machine sat a week behind with
# every launch looking normal. The box twin already exports it around its own
# update step; this is the Mac catching up.
export PATH="$HOME/.local/bin:$PATH"

# Every prerequisite is checked before anything is created, and each failure
# names its own fix: a launcher that half-starts an agent is worse than one
# that refuses.
command -v tmux >/dev/null 2>&1 || {
    echo "launch-claude-mac: tmux is not installed on this Mac — install it (brew install tmux) and re-run" >&2
    exit 2
}
command -v claude >/dev/null 2>&1 || {
    echo "launch-claude-mac: claude is not on the PATH — install Claude Code on this Mac and re-run" >&2
    exit 2
}
[ -f "$SUPERVISOR" ] || {
    echo "launch-claude-mac: no handoff-supervisor.py at $SUPERVISOR — run the copy inside a nedschorus checkout" >&2
    exit 2
}

# Update Claude Code before starting the seat, so a fresh agent starts
# current. Launch is no longer the fleet's ONLY update moment: since
# 2026-09-22 handoff-supervisor.py updates before every session it launches,
# which covers the handoff restart, crash recovery and the login restart
# (see update_agent_binary there). This step stays because a launcher starts
# a seat the supervisor has not reached yet. Background auto-update
# is off via DISABLE_AUTOUPDATER in the checked-in .claude/settings.json
# (user-ruled 2026-08-22: with launch-time updates, the mid-session update
# banner is clutter); that switch leaves this explicit `claude update`
# working. Running sessions are unaffected by an update (user-established
# across many updates: installed versions are retained on disk). A failed
# or slow update proceeds anyway, because an update problem must never
# block starting an agent: `|| true` is what holds that under `set -eu`,
# not decoration.
#
# The update runs under the machine-wide lock in
# scripts/agent-binary-update-under-lock.py, which the supervisor takes too,
# so no two updates on this Mac overlap (user-approved 2026-09-22): a login
# restart otherwise starts one supervisor's update about 6 s after the last.
# That file owns the timeout as well, and says why the perl alarm that was
# here had to go: kept outside it, the alarm would kill the Python holding
# the lock and orphan a still-running update. The one budget covers waiting
# for the lock and running the update together.
#
# The launcher writes no warning of its own. The one removed here claimed
# to report a failed update but could not see the failure that actually
# happened: on 2026-08-31 this Mac was found frozen at 2.1.241 for a week
# because `claude update` refuses to overwrite a Homebrew-managed copy. It
# printed the reason and exited 0, so the `||` branch never ran and every
# launch looked normal. `claude update` prints its own diagnosis whenever it
# runs to completion, so a launcher paraphrase adds nothing and can mislead.
# The install was repaired instead, to the native build at ~/.local/bin that
# both launchers already assume (user-ruled 2026-08-31).
#
# The helper reports only what it causes, prefixed with this launcher's name:
# an update it killed at the limit, a wait for the lock, and an update it
# skipped because the lock stayed held past the limit.
# 120 seconds, raised from 45 (user-ruled 2026-08-31): a slow but WORKING
# update killed at the limit leaves the machine silently on its old version,
# which is the same outcome as the refused update above and just as quiet.
# The limit exists to bound a hung update, not to race a real download, so it
# is set well clear of one. A limit of 0 skips the update.
UPDATE_TIMEOUT="${LAUNCH_CLAUDE_UPDATE_TIMEOUT_SECONDS:-120}"
echo "launch-claude-mac: checking for a Claude Code update"
python3 "$SCRIPT_DIRECTORY/agent-binary-update-under-lock.py" \
    --program-name launch-claude-mac --timeout-seconds "$UPDATE_TIMEOUT" \
    -- claude update || true

AGENT_DIRECTORY="$AGENTS_ROOT/$AGENT_NAME"
mkdir -p "$AGENT_DIRECTORY"

# Pre-trust the agent directory: a fresh directory otherwise stops at Claude's
# one-time folder-trust dialog, which a detached launch can never answer and an
# attached one should not have to.
#
# The flag is written through a temporary sibling that REPLACES the file, and
# never by truncating ~/.claude.json itself (as this step did until
# 2026-09-08). That file is the harness's own live state file: running
# sessions write it too — its mtime was observed changing mid-session on this
# Mac — so a truncate-and-stream here is a file the harness can read torn,
# and a fresh session reading torn JSON can stop at the very trust dialog
# this step exists to skip. os.replace is atomic on macOS and Linux alike, so
# a concurrent reader sees the whole old file or the whole new one, never a
# partial one. The precedent is write_atomically in
# nc-systems/main-gatekeeper/main-gatekeeper.py (ruled 2026-08-12), and this follows it with two
# measured differences:
#   - the temporary name is mkstemp-unique rather than that function's fixed
#     `.<name>.writing` sibling, because two launches can overlap here where
#     the gatekeeper's single worker could not, and a shared temporary name
#     lets one launcher rename the other's half-written file into place;
#   - the bytes go out through Path.write_text, not open(path, "w").write().
#     Measured 2026-09-08: with the plain-open form, a write that fails
#     (RLIMIT_FSIZE, and a full disk the same way) leaves the buffered flush
#     error to deallocation, where CPython IGNORES it — os.replace then
#     published an EMPTY .claude.json and the launcher exited 0. write_text
#     raises instead, so the failure stops before the replace and the
#     original file is left untouched.
# os.replace takes the temporary file's mode, not the target's, so the
# original mode is carried across explicitly: this file may hold
# credentials, and the harness's own copy was measured at 0600 on this Mac.
# A file created fresh here is 0600 for the same reason, rather than the
# umask-derived 0644 the old truncating open produced.
#
# What this deliberately does NOT fix: the read-modify-write itself. A
# harness write landing between the read and the replace is still lost, and
# so is one seat's flag when two launches overlap. No lock is taken, because
# the harness holds no lock of ours and so a lock cannot close the case that
# actually happens; a lock for the launcher-against-launcher case would mean
# a permanent extra file in HOME for a collision the fleet has not seen
# (recover-crashed-seats.py works through its seats one at a time,
# resupervise-seat.py launches one), and a lock ON the target is useless
# under rename — the second writer would hold it on the freed inode. What
# remains after this change costs one trust flag, and so at worst one
# re-shown dialog; what it removes is a corrupted state file.
# The twin does the same on the box, at scripts/launch-claude-ubuntu.
python3 -c 'import json, os, pathlib, sys, tempfile
path = os.path.expanduser("~/.claude.json")
settings = json.load(open(path)) if os.path.exists(path) else {}
target = os.path.abspath(os.path.expanduser(sys.argv[1]))
settings.setdefault("projects", {}).setdefault(target, {})["hasTrustDialogAccepted"] = True
mode = os.stat(path).st_mode & 0o777 if os.path.exists(path) else 0o600
handle, temporary = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".claude.json.", suffix=".launch-claude-writing")
os.close(handle)
pathlib.Path(temporary).write_text(json.dumps(settings, indent=2), encoding="utf-8")
os.chmod(temporary, mode)
os.replace(temporary, path)' "$AGENT_DIRECTORY"

# The agent's home must be a CHECKOUT before the session starts, not after:
# project settings — status line, the reincarnation Stop hook, the instruction-file
# guard — are read from .claude/ inside the working directory at session
# start, so an agent booted into a bare directory runs with none of them, and
# fixing its own home later cannot retrofit the session it is already in.
# Skipped when the home is already a checkout; an existing branch is reused,
# since git allows a branch in only one worktree at a time.
REPOSITORY=$(cd "$SCRIPT_DIRECTORY/.." && pwd)
if ! git -C "$AGENT_DIRECTORY" rev-parse --show-toplevel >/dev/null 2>&1; then
    git -C "$REPOSITORY" fetch --quiet origin || true
    git -C "$REPOSITORY" worktree add "$AGENT_DIRECTORY" -b "$AGENT_NAME" origin/main 2>/dev/null \
        || git -C "$REPOSITORY" worktree add "$AGENT_DIRECTORY" "$AGENT_NAME" \
        || echo "launch-claude-mac: could not make $AGENT_DIRECTORY a checkout; the agent will start without project settings" >&2
fi

# Boot-time worktree report: finished session worktrees pile up invisibly,
# so each launch names any that are done (clean, landed, vacant) and the
# command that removes them. Report only — removal stays a deliberate,
# separate call — and a report problem never blocks a launch.
python3 "$SCRIPT_DIRECTORY/clean-worktrees.py" --only-done || true

# Boot-time freshness: fast-forward the machine's reference checkout to
# origin/main (ff-only, never a merge — it carries no work of its own by
# construction). The mid-session half runs as a Stop hook
# (scripts/checkout-freshness-catch-up.py); this covers machines between
# sessions, and never blocks a launch.
python3 "$SCRIPT_DIRECTORY/checkout-freshness-catch-up.py" --reference-pull --repo "$REPOSITORY" 2>/dev/null || true

# Per-seat tmux servers (2026-08-21): every seat runs on its OWN tmux server,
# socket `-L <name>`, because the Mac's single default server died that day
# and took all three Mac seats down at once — one server crash must not kill
# the whole per-machine fleet. Transition rule: seats launched before this
# change still live on the DEFAULT server, so when the seat's own server does
# not hold its session but the default one does, this launch reaches it there
# — otherwise attach-or-create would start a duplicate seat beside the
# running one. `-L default` names the default socket, so one variable serves
# both cases.
SEAT_TMUX_SOCKET="$AGENT_NAME"
if ! tmux -L "$AGENT_NAME" has-session -t "=$AGENT_NAME" 2>/dev/null \
        && tmux -L default has-session -t "=$AGENT_NAME" 2>/dev/null; then
    SEAT_TMUX_SOCKET=default
fi

# Values spliced between single quotes in the shell-parsed commands below
# must have their own single quotes escaped, or an apostrophe in the value
# ends the quote early and the composed command fails to parse — after the
# caller was already told the launch succeeded (PR #134 review round 2: an
# apostrophe --handoff-dir lands in the recovery prompt-file path, and an
# apostrophe agents root reaches AGENT_DIRECTORY through
# NEDSCHORUS_AGENTS_ROOT). AGENT_NAME needs no escaping — validated above
# to letters, digits, - and _ — and the supervisor path is the checkout's
# own location, not reachable through any override.
escape_single_quotes() {
    printf "%s" "$1" | sed "s/'/'\\\\''/g"
}
QUOTED_AGENT_DIRECTORY=$(escape_single_quotes "$AGENT_DIRECTORY")

# Task-list persistence across seat generations. The harness keys its native
# task store by CLAUDE_CODE_TASK_LIST_ID when that is set, and by the session
# id otherwise, so a seat left to the default gets a NEW empty list every
# time the supervisor reincarnates it. Binding the id to the seat's NAME makes
# every generation of that seat open the same list — the same store, not a
# copy of it, so nothing has to be migrated at a handoff. Ported from the
# legacy system, which has run it since nedlern#1257
# (~/Projects/nedlern/tasks/sessions/.agent-wrapper.sh:341); the two warnings
# below are what that system learned from running it.
#
# Warning 1 — the store is ONE copy on ONE disk, outside the repository:
# $HOME/.claude/tasks/nedschorus-<name>-tasks/ on this Mac. It is not committed, not
# backed up with the repository, and not shared with the box, so the same
# seat name on both machines keeps two unrelated lists. On THIS Mac the
# reverse held too, and it was the sharper half: the legacy system's
# wrapper (~/Projects/nedlern/tasks/sessions/.agent-wrapper.sh:341) composes
# the unprefixed "<name>-tasks" id into the same $HOME/.claude/tasks/, so a
# nedschorus seat and a nedlern agent of the same name would have shared ONE
# list rather than colliding visibly. The project prefix closes that, and it
# is also why the prefix exists at all (user-ruled 2026-08-29): the day
# nedschorus agents serve several projects, every seat name recurs per
# project, and an id composed from the seat name alone cannot tell them
# apart. Nobody hand-writes a store id — a human names the SEAT, and this
# launcher, the one place the id is composed, names the store; a store id
# met in prose is a claim about the disk, verified there before use.
#
# Warning 2 — a session started OUTSIDE this launcher binds ELSEWHERE, and
# the failure is silent. Without this export, `claude` falls back to the
# session-keyed store, which is a directory that has never existed: TaskList
# returns an empty list and TaskUpdate answers "Task not found", both with no
# error and both looking exactly like a seat that simply has no tasks. The
# after-exit shell below inherits this export precisely so the
# `claude --continue` it offers keeps the binding; a `claude` typed in any
# other terminal does not.
#
# AGENT_NAME needs no escaping here — validated above to letters, digits, -
# and _ — so the composed id is always a plain directory name.
#
# The task tools themselves are opt-in on current models: Claude Code 2.1.233
# withdrew TaskCreate/Get/Update/List and TodoWrite from Opus 4.8, Sonnet 5,
# Fable 5, Mythos 5 and newer, and CLAUDE_CODE_ENABLE_TODO_TOOLS=1 restores
# them. Measured on this Mac 2026-08-22 (Claude Code 2.1.238, model
# claude-sonnet-5): with the enable variable unset, the pin alone does
# nothing — TaskCreate is not among the visible tools and no store directory
# is ever created. The two are not symmetric, and it is worth being exact,
# because reading them as interchangeable is what hid the supervisor's stale
# accounting for a review round: the PIN alone does nothing, while ENABLE
# alone gives a seat working task tools on a session-keyed store, whose
# records the supervisor's pre-seed then carries across reincarnations
# (handoff-supervisor.py, preseed_tasks). The pin is what makes the list the
# SEAT's — one store every generation opens, rather than a fresh directory
# each reincarnation has to copy into.
# One-time migration (user-ruled 2026-08-29): a store filled under the old
# unprefixed '<name>-tasks' id is renamed to the prefixed id at launch, so a
# relaunched seat keeps its list and the stale name dies loudly (no
# directory) instead of lingering as a plausible fork. Never when the
# prefixed store already exists: an in-use list is not overwritten.
UNPREFIXED_TASK_STORE="$HOME/.claude/tasks/$AGENT_NAME-tasks"
PREFIXED_TASK_STORE="$HOME/.claude/tasks/nedschorus-$AGENT_NAME-tasks"
if [ -d "$UNPREFIXED_TASK_STORE" ] && [ ! -e "$PREFIXED_TASK_STORE" ]; then
    mv "$UNPREFIXED_TASK_STORE" "$PREFIXED_TASK_STORE"
fi

# The seat's own GitHub credential. The token is never read HERE and never
# put in the composed string: the string is handed to tmux, so a token
# spliced into it would stand in every `ps` listing on the machine for as
# long as the seat lives. What is composed is the READ — `IFS= read -r`
# against the file — which the seat's own pane shell performs, so the value
# exists only inside that process tree. `$(cat ...)` would do the same job
# on this Mac, where the pane command is parsed once; it is not used,
# because the box twin's pane command crosses a second parse where the box's
# login shell would run the substitution and splice the token into the
# string tmux receives (measured 2026-09-22 against
# scripts/launch-claude-ubuntu-test.py's tmux-argv capture). The two twins
# carry the same shape so neither drifts into that.
#
# `IFS= read -r` rather than a bare `read`: IFS= keeps a leading or trailing
# space in the file out of the split, and -r keeps a backslash literal. It
# stops at the first newline, which is what strips the trailing one a text
# editor adds. Its status is discarded — a file with no trailing newline
# makes `read` return non-zero AFTER setting the variable — because `export`
# follows it inside the same `if`.
#
# The leading `unset GH_TOKEN` is what makes the warning below true rather
# than nearly true: without it, a seat launched from a shell that already
# carried a GH_TOKEN — the merge-lane seat exports one by hand today —
# would silently keep that credential when its own token file is missing,
# and the launcher would be announcing a fallback to the keyring that did
# not happen. The seat's account is decided here, never inherited.
#
# The `if` is what keeps GH_TOKEN UNSET rather than empty when the file is
# missing: `gh` falls back to its keyring login on an unset variable and
# fails outright on an empty one, so the two are not interchangeable. It
# re-checks what the warning below already checked, a few milliseconds
# apart on the same filesystem; the check that decides is this one, in the
# seat's own shell at the moment the seat starts.
#
# The after-exit shell inherits this export, as it inherits the task-list
# pin below and for the same reason: the `claude --continue` that shell
# offers is the same seat, and a `gh` typed there is the seat acting, not
# the user. Nothing is re-exported for it — it is the same pane shell.
#
# SEAT_GITHUB_ACCOUNT needs no escaping — validated above to letters,
# digits, - and _ — so the composed path is always a plain file name.
SEAT_GITHUB_TOKEN_FILE_UNDER_HOME=".config/nedschorus/$SEAT_GITHUB_ACCOUNT.token"
SEAT_GITHUB_TOKEN_FILE="$HOME/$SEAT_GITHUB_TOKEN_FILE_UNDER_HOME"

# A missing token file WARNS and launches anyway, rather than refusing
# (user-ruled 2026-09-22): the box holds no `ubuntu-claude.token` today, and
# a launcher that refused would take every seat on both machines down at
# once over a credential that is an improvement, not a prerequisite. The
# warning is loud because the fallback is the defect this change exists to
# close — the seat runs as whatever `gh`'s keyring holds, which on this Mac
# is the user's own organization-admin credential.
if [ ! -s "$SEAT_GITHUB_TOKEN_FILE" ]; then
    echo "launch-claude-mac: ============================================================" >&2
    echo "launch-claude-mac: NO SEAT TOKEN — $AGENT_NAME will NOT act as $SEAT_GITHUB_ACCOUNT" >&2
    echo "launch-claude-mac:   account wanted: $SEAT_GITHUB_ACCOUNT" >&2
    echo "launch-claude-mac:   file looked in: $SEAT_GITHUB_TOKEN_FILE" >&2
    echo "launch-claude-mac:   GH_TOKEN stays unset, so gh and git act as gh's keyring login on this Mac, the user's own account" >&2
    echo "launch-claude-mac:   write that account's fine-grained token to that file, mode 600, then relaunch this seat" >&2
    echo "launch-claude-mac:   or export NEDSCHORUS_SEAT_GITHUB_ACCOUNT naming an account whose token file is there" >&2
    echo "launch-claude-mac: ============================================================" >&2
fi

# The seat's own git identity (user-approved 2026-09-22, the walk
# ghi-write-session-open-rulings-and-concerns item 7; his naming words: "I'd
# probably use the name of the agent, or if namelss, the model and effort
# ofthe agent"). Author and committer, name and email, are all set per
# process, so the seat commits as itself whatever the shared .git/config
# holds. That config is one file behind every worktree of the clone, and
# any agent's `git config user.name` rewrote it for every seat at once:
# measured 2026-09-22, one seat's commits went out that day as
# identity-probe, as reviewer, and once as identity-probe <junk@lerner1.com>,
# the user's own address, on a public pull request. The environment outranks
# the config at commit time, and rewriting the config between two commits
# does not move it (measured before the design was approved).
#
# The email is <seat>@nedschorus.invalid: RFC 2606 reserves .invalid, so the
# address can never be anyone's real one. AGENT_NAME needs no escaping here
# (charset-checked above to letters, digits, - and _).
#
# Subagents inherit the seat's environment, so a subagent commits as its
# seat. Naming unnamed subagents by model and effort is deferred, with the
# user's agreement; the Claude-Session trailer already tells sessions apart.
#
# The after-exit shell inherits this export too: a `git commit` typed there
# is the seat acting, as a `gh` typed there is.
#
# scripts/git-client-side-hooks/pre-commit refuses a commit made inside a
# Claude session that is authored or committed by the user's own address or
# by the unconfigured-agent tripwire; it is what catches a session started
# without this launcher once the tripwire is in the shared config.
SUPERVISOR_COMMAND="export PATH=\"\$HOME/.local/bin:\$PATH\"; \
unset GH_TOKEN; if [ -s \"\$HOME/$SEAT_GITHUB_TOKEN_FILE_UNDER_HOME\" ]; then IFS= read -r GH_TOKEN < \"\$HOME/$SEAT_GITHUB_TOKEN_FILE_UNDER_HOME\"; export GH_TOKEN; fi; \
export CLAUDE_CODE_TASK_LIST_ID='nedschorus-$AGENT_NAME-tasks'; \
export CLAUDE_CODE_ENABLE_TODO_TOOLS=1; \
export GIT_AUTHOR_NAME='$AGENT_NAME' GIT_AUTHOR_EMAIL='$AGENT_NAME@nedschorus.invalid' GIT_COMMITTER_NAME='$AGENT_NAME' GIT_COMMITTER_EMAIL='$AGENT_NAME@nedschorus.invalid'; \
python3 '$SUPERVISOR' --agent '$AGENT_NAME' --cd '$QUOTED_AGENT_DIRECTORY'"

# A first-prompt file seeds only the FIRST session. The supervisor reads the
# file itself, so its content never rides through shell quoting.
if [ -n "$FIRST_PROMPT_FILE" ]; then
    SUPERVISOR_COMMAND="$SUPERVISOR_COMMAND --first-prompt-file '$(escape_single_quotes "$FIRST_PROMPT_FILE")'"
fi

# Extra supervisor arguments from the environment — the hook crash recovery
# rides (recover-crashed-seats.py sets --resume-session-id through it,
# nedschorus#120). An environment variable rather than a flag because the
# launcher's argument surface is operator-facing and stable, while this is
# machinery-to-machinery; callers own the quoting of what they pass.
# The variable is fully consumed here and is unset before the tmux server
# starts, so the seat's process tree never inherits it. Measured 2026-09-03:
# a seat recovered with --resume-session-id ran `launch-claude-mac
# <other-seat>` from its Bash tool, the launcher found the inherited value,
# and the other seat came up as `claude --resume <the recovering session's
# id>` in the wrong directory, appending 71+ wrong-cwd records to the first
# seat's transcript before it was killed by hand.
if [ -n "${LAUNCH_CLAUDE_SUPERVISOR_EXTRA_ARGUMENTS:-}" ]; then
    SUPERVISOR_COMMAND="$SUPERVISOR_COMMAND $LAUNCH_CLAUDE_SUPERVISOR_EXTRA_ARGUMENTS"
fi
unset LAUNCH_CLAUDE_SUPERVISOR_EXTRA_ARGUMENTS

# When the supervisor exits, the pane becomes an interactive shell in the
# agent's directory rather than closing (user-ruled 2026-08-17): a stopped
# seat is relaunched in place, with no hunt for the right cd. The options are
# printed supervised-first, because `claude --continue` starts no supervisor
# and its seat can never reincarnate (nedschorus#45). The tmux session — and so the window — now outlives the
# supervisor and closes when this shell exits. Re-running the launcher on
# such a session ATTACHES to that shell (new-session -A ignores the command
# for an existing name); the printed options cover it. The leading trap lets
# the wrapper survive a Ctrl-C aimed at the supervisor — the tty signals the
# whole foreground group, and an untrapped wrapper died before reaching the
# shell (review finding, 2026-08-17); a handled trap, unlike an ignore, is
# not inherited, so the supervisor's own Ctrl-C handling is untouched.
# Attached launches only: a --no-attach seat keeps the old close-on-exit
# behavior, because a shell nobody is watching in a detached session would
# leak, and would turn the "already running" refusal below into a lie
# automation acts on (review finding, 2026-08-17).
AFTER_EXIT_COMMAND="echo; \
echo \"launch-claude-mac: the $AGENT_NAME supervisor exited; this shell is in the seat's directory\"; \
echo \"  fresh supervised seat:  exit, then launch-claude-mac $AGENT_NAME\"; \
echo \"  resume this dialog:     claude --continue — starts NO supervisor, so that\"; \
echo \"                          seat can never reincarnate until it is recovered\"; \
cd '$QUOTED_AGENT_DIRECTORY'; exec \${SHELL:-/bin/sh}"

# The chained set-option calls tell the terminal the session name, so the
# tab reads the seat's name rather than the command that happened to start
# it. They ride the same tmux invocation (\; separates tmux commands, not
# shell ones) because the seat's server does not exist before its first
# session does — a standalone set-option beforehand would find no server —
# and repeating them on an attach is harmless.
if [ "$ATTACH" = yes ]; then
    exec tmux -L "$SEAT_TMUX_SOCKET" new-session -A -s "$AGENT_NAME" -c "$AGENT_DIRECTORY" \
        "trap ':' INT QUIT; $SUPERVISOR_COMMAND; $AFTER_EXIT_COMMAND" \; \
        set-option -g set-titles on \; set-option -g set-titles-string '#S'
fi
tmux -L "$SEAT_TMUX_SOCKET" new-session -d -s "$AGENT_NAME" -c "$AGENT_DIRECTORY" "$SUPERVISOR_COMMAND" \; \
        set-option -g set-titles on \; set-option -g set-titles-string '#S' 2>/dev/null \
    || echo "launch-claude-mac: a tmux session named $AGENT_NAME already exists — a running seat, or its after-exit shell (attach with: launch-claude-mac $AGENT_NAME)"
