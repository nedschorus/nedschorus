#!/bin/sh
# launch-claude-mac <name> [--no-attach] — reach the named agent ON THIS MAC.
#
# The local twin of launch-claude-ubuntu, sharing every convention and none of
# the SSH: the name you type is the whole configuration, the agent's directory
# is $NEDSCHORUS_AGENTS_ROOT/<name> (default ~/agents/<name>), created on first
# use, and a CLAUDE.local.md in that directory supplies the agent's identity —
# without one the agent is generic and the name is just a label.
#
# Which twin to type: the Ubuntu box is the default home for agent work (more
# memory, CPU and bandwidth, and it does not compete with the user's machine).
# Use THIS script only for work that must run where the user sits — anything
# needing the Mac's browser session, its keychain, its GUI, or files that live
# only on it. The machine is in both names because the choice is a real one and
# the wrong pick is easy to make.
#
# Attach-or-create comes from tmux: `new-session -A` attaches to the session
# named <name> when it exists and creates it when it does not, so a closed
# terminal window never orphans an agent — type the same command to reconnect.
# Inside the session runs the handoff supervisor, which launches the claude
# session, recycles it on every handoff, and exits when its agent stops without
# handing off. On an ATTACHED launch the pane then drops into an interactive
# shell in the agent's directory (surviving a Ctrl-C aimed at the supervisor),
# so the seat can be resumed in place with `claude --continue` and no hunting
# for the right cd (user-ruled 2026-08-17) — the tmux session closes when that
# shell exits. That shell offers the SUPERVISED relaunch first and states what
# `claude --continue` costs: it resumes the dialog with no supervisor, so the
# seat can never recycle. The old ordering advertised --continue first, and on
# 2026-08-18 two seats ran unsupervised for about 25 hours because it was the
# only listed option that worked (nedschorus#45). A seat born with --no-attach keeps the old close-on-exit
# behavior instead, even if attached later: its pane command is fixed at
# creation. A second launch of a running name attaches instead of
# duplicating, and the supervisor holds a per-agent lock that refuses a
# second copy even if tmux is bypassed.
# Both protections are per-machine, as is every other thing an agent owns, so
# the same name used on both machines is simply two unrelated agents — no
# conflict, only a label you cannot tell apart in a listing spanning both.
#
# Every seat runs on its OWN tmux server (`tmux -L <name>`, one socket per
# seat under /tmp/tmux-<uid>/), so one server crash cannot take the whole
# per-machine fleet down: on 2026-08-21 the Mac's single default tmux server
# died and killed all three Mac seats at once. Seats launched before that
# change still live on the default server; the socket selection below reaches
# them there instead of starting a duplicate.
#
# --no-attach creates the session without attaching this terminal (for scripts
# and checks); attach later by running the plain form.
#
# Requires on this Mac: tmux, python3, and claude on the PATH.

set -eu

AGENTS_ROOT="${NEDSCHORUS_AGENTS_ROOT:-$HOME/agents}"
# A literal-tilde value (a quoted export sends one) is resolved or refused,
# never half-worked (PR #137 review P3 on the twin, user-ruled 2026-08-22:
# overrides either work or are blocked): ~/ becomes $HOME as the operator's
# shell would have made it, and every fleet Python tool already
# expanduser()s the same value; a ~user/ form is refused, because this
# script would mkdir a literal ~user directory while those tools resolve
# that user's real home — one seat, silently split across two directories.
case "$AGENTS_ROOT" in
    ("~"[!/]*)
        echo "launch-claude-mac: ~user agents roots are not supported — the shell and the fleet's Python tools resolve them to different directories, splitting the seat. Use an absolute path." >&2
        exit 2 ;;
    ("~") AGENTS_ROOT="$HOME" ;;
    ("~/"*) AGENTS_ROOT="$HOME${AGENTS_ROOT#?}" ;;
esac

# The supervisor is this script's sibling, so the checkout location is never
# configured and never wrong — wherever this script was run from IS the
# checkout it belongs to.
SCRIPT_DIRECTORY=$(cd "$(dirname "$0")" && pwd)
SUPERVISOR="$SCRIPT_DIRECTORY/handoff-supervisor.py"

# The no-name case is the common mistake, so it teaches rather than scolds:
# what a name is for, and which agents are running right now to pick from or
# avoid colliding with.
usage() {
    echo "usage: launch-claude-mac <name> [--no-attach] [--first-prompt-file <path>]" >&2
    echo >&2
    echo "Every agent is named, and the name is the whole configuration: it names the" >&2
    echo "tmux session, the home directory ($AGENTS_ROOT/<name>), and the agent's handoff" >&2
    echo "files. Running a name that is already up ATTACHES to that agent — you cannot" >&2
    echo "start a second copy of one." >&2
    echo >&2
    # Per-seat tmux servers: one list-sessions cannot see every seat, so walk
    # every socket in tmux's socket directory — per-seat servers and the
    # default server (where pre-2026-08-21 seats still live) alike. A dead
    # socket's listing fails and is skipped.
    running=$(
        for seat_socket_path in "${TMUX_TMPDIR:-/tmp}/tmux-$(id -u)"/*; do
            [ -S "$seat_socket_path" ] || continue
            # name@socket, not the bare name: one name on TWO sockets is the
            # decoy class resupervise-seat.py kills (PR #122 review P3-5),
            # and a deduplicated listing would hide exactly that.
            tmux -S "$seat_socket_path" list-sessions -F "#{session_name}@$(basename "$seat_socket_path")" 2>/dev/null || true
        done | sort -u | tr '\n' ' ')
    if [ -n "$running" ]; then
        echo "Agent tmux sessions on this Mac now (live seats or after-exit shells): $running" >&2
    else
        echo "No agent tmux sessions on this Mac now." >&2
    fi
    echo "(Agents on the Ubuntu box are separate: launch-claude-ubuntu.)" >&2
    echo >&2
    echo "The two machines share no agent state — tmux sessions, home directories," >&2
    echo "handoff files and locks are all per-machine — so the same name on both is two" >&2
    echo "unrelated agents, not a conflict. Suffix names (-mac, -ubuntu) only if you want" >&2
    echo "to tell them apart at a glance; nothing here requires it." >&2
    exit 2
}

[ $# -ge 1 ] || usage
AGENT_NAME="$1"
shift
ATTACH=yes
FIRST_PROMPT_FILE=""
while [ $# -gt 0 ]; do
    case "$1" in
        (--no-attach) ATTACH=no; shift ;;
        (--first-prompt-file) FIRST_PROMPT_FILE="${2:?--first-prompt-file needs a path}"; shift 2 ;;
        (*) usage ;;
    esac
done
case "$AGENT_NAME" in
    (*[!a-zA-Z0-9_-]*|"") echo "launch-claude-mac: agent names are letters, digits, - and _" >&2; exit 2 ;;
esac

# Every prerequisite is checked before anything is created, and each failure
# names its own fix: a launcher that half-starts an agent is worse than one
# that refuses.
command -v tmux >/dev/null 2>&1 || {
    echo "launch-claude-mac: tmux is not installed on this Mac — install it (brew install tmux) and re-run" >&2
    exit 2
}
command -v claude >/dev/null 2>&1 || {
    echo "launch-claude-mac: claude is not on the PATH — install Claude Code on this Mac and re-run" >&2
    exit 2
}
[ -f "$SUPERVISOR" ] || {
    echo "launch-claude-mac: no handoff-supervisor.py beside this script ($SUPERVISOR) — run the copy inside a nedschorus checkout" >&2
    exit 2
}

# Update Claude Code before starting the seat: launch is the fleet's one
# update moment — every fresh agent starts current. Background auto-update
# is off via DISABLE_AUTOUPDATER in the checked-in .claude/settings.json
# (user-ruled 2026-08-22: with launch-time updates, the mid-session update
# banner is clutter); that switch leaves this explicit `claude update`
# working. Running sessions are unaffected by an update (user-established
# across many updates: installed versions are retained on disk). A failed
# or slow update warns and proceeds, because an update problem must never
# block starting an agent.
UPDATE_TIMEOUT="${LAUNCH_CLAUDE_UPDATE_TIMEOUT_SECONDS:-45}"
echo "launch-claude-mac: checking for a Claude Code update"
perl -e 'alarm shift; exec @ARGV' "$UPDATE_TIMEOUT" claude update \
    || echo "launch-claude-mac: claude update failed or timed out; launching on the installed version" >&2

AGENT_DIRECTORY="$AGENTS_ROOT/$AGENT_NAME"
mkdir -p "$AGENT_DIRECTORY"

# Pre-trust the agent directory: a fresh directory otherwise stops at Claude's
# one-time folder-trust dialog, which a detached launch can never answer and an
# attached one should not have to.
python3 -c 'import json,os,sys
path = os.path.expanduser("~/.claude.json")
settings = json.load(open(path)) if os.path.exists(path) else {}
target = os.path.abspath(os.path.expanduser(sys.argv[1]))
settings.setdefault("projects", {}).setdefault(target, {})["hasTrustDialogAccepted"] = True
json.dump(settings, open(path, "w"), indent=2)' "$AGENT_DIRECTORY"

# The agent's home must be a CHECKOUT before the session starts, not after:
# project settings — status line, the recycle Stop hook, the instruction-file
# guard — are read from .claude/ inside the working directory at session
# start, so an agent booted into a bare directory runs with none of them, and
# fixing its own home later cannot retrofit the session it is already in.
# Skipped when the home is already a checkout; an existing branch is reused,
# since git allows a branch in only one worktree at a time.
REPOSITORY=$(cd "$SCRIPT_DIRECTORY/.." && pwd)
if ! git -C "$AGENT_DIRECTORY" rev-parse --show-toplevel >/dev/null 2>&1; then
    git -C "$REPOSITORY" fetch --quiet origin || true
    git -C "$REPOSITORY" worktree add "$AGENT_DIRECTORY" -b "$AGENT_NAME" origin/main 2>/dev/null \
        || git -C "$REPOSITORY" worktree add "$AGENT_DIRECTORY" "$AGENT_NAME" \
        || echo "launch-claude-mac: could not make $AGENT_DIRECTORY a checkout; the agent will start without project settings" >&2
fi

# Boot-time worktree report: finished session worktrees pile up invisibly,
# so each launch names any that are done (clean, landed, vacant) and the
# command that removes them. Report only — removal stays a deliberate,
# separate call — and a report problem never blocks a launch.
python3 "$SCRIPT_DIRECTORY/clean-worktrees.py" --only-done || true

# Boot-time freshness: fast-forward the machine's reference checkout to
# origin/main (ff-only, never a merge — it carries no work of its own by
# construction). The mid-session half runs as a Stop hook
# (scripts/checkout-freshness-catch-up.py); this covers machines between
# sessions, and never blocks a launch.
python3 "$SCRIPT_DIRECTORY/checkout-freshness-catch-up.py" --reference-pull --repo "$REPOSITORY" 2>/dev/null || true

# Per-seat tmux servers (2026-08-21): every seat runs on its OWN tmux server,
# socket `-L <name>`, because the Mac's single default server died that day
# and took all three Mac seats down at once — one server crash must not kill
# the whole per-machine fleet. Transition rule: seats launched before this
# change still live on the DEFAULT server, so when the seat's own server does
# not hold its session but the default one does, this launch reaches it there
# — otherwise attach-or-create would start a duplicate seat beside the
# running one. `-L default` names the default socket, so one variable serves
# both cases.
SEAT_TMUX_SOCKET="$AGENT_NAME"
if ! tmux -L "$AGENT_NAME" has-session -t "=$AGENT_NAME" 2>/dev/null \
        && tmux -L default has-session -t "=$AGENT_NAME" 2>/dev/null; then
    SEAT_TMUX_SOCKET=default
fi

# Values spliced between single quotes in the shell-parsed commands below
# must have their own single quotes escaped, or an apostrophe in the value
# ends the quote early and the composed command fails to parse — after the
# caller was already told the launch succeeded (PR #134 review round 2: an
# apostrophe --handoff-dir lands in the recovery prompt-file path, and an
# apostrophe agents root reaches AGENT_DIRECTORY through
# NEDSCHORUS_AGENTS_ROOT). AGENT_NAME needs no escaping — validated above
# to letters, digits, - and _ — and the supervisor path is the checkout's
# own location, not reachable through any override.
escape_single_quotes() {
    printf "%s" "$1" | sed "s/'/'\\\\''/g"
}
QUOTED_AGENT_DIRECTORY=$(escape_single_quotes "$AGENT_DIRECTORY")

# Task-list persistence across seat generations. The harness keys its native
# task store by CLAUDE_CODE_TASK_LIST_ID when that is set, and by the session
# id otherwise, so a seat left to the default gets a NEW empty list every
# time the supervisor recycles it. Binding the id to the seat's NAME makes
# every generation of that seat open the same list — the same store, not a
# copy of it, so nothing has to be migrated at a handoff. Ported from the
# legacy system, which has run it since nedlern#1257
# (~/Projects/nedlern/tasks/sessions/.agent-wrapper.sh:341); the two warnings
# below are what that system learned from running it.
#
# Warning 1 — the store is ONE copy on ONE disk, outside the repository:
# $HOME/.claude/tasks/<name>-tasks/ on this Mac. It is not committed, not
# backed up with the repository, and not shared with the box, so the same
# seat name on both machines keeps two unrelated lists.
#
# Warning 2 — a session started OUTSIDE this launcher binds ELSEWHERE, and
# the failure is silent. Without this export, `claude` falls back to the
# session-keyed store, which is a directory that has never existed: TaskList
# returns an empty list and TaskUpdate answers "Task not found", both with no
# error and both looking exactly like a seat that simply has no tasks. The
# after-exit shell below inherits this export precisely so the
# `claude --continue` it offers keeps the binding; a `claude` typed in any
# other terminal does not.
#
# AGENT_NAME needs no escaping here — validated above to letters, digits, -
# and _ — so the composed id is always a plain directory name.
#
# The task tools themselves are opt-in on current models: Claude Code 2.1.233
# withdrew TaskCreate/Get/Update/List and TodoWrite from Opus 4.8, Sonnet 5,
# Fable 5, Mythos 5 and newer, and CLAUDE_CODE_ENABLE_TODO_TOOLS=1 restores
# them. Measured on this Mac 2026-08-22 (Claude Code 2.1.238, model
# claude-sonnet-5): with the enable variable unset, the pin alone does
# nothing — TaskCreate is not among the visible tools and no store directory
# is ever created. Both variables are therefore required, and neither is
# useful alone.
SUPERVISOR_COMMAND="export PATH=\"\$HOME/.local/bin:\$PATH\"; \
export CLAUDE_CODE_TASK_LIST_ID='$AGENT_NAME-tasks'; \
export CLAUDE_CODE_ENABLE_TODO_TOOLS=1; \
python3 '$SUPERVISOR' --agent '$AGENT_NAME' --cd '$QUOTED_AGENT_DIRECTORY'"

# A first-prompt file seeds only the FIRST session. The supervisor reads the
# file itself, so its content never rides through shell quoting.
if [ -n "$FIRST_PROMPT_FILE" ]; then
    SUPERVISOR_COMMAND="$SUPERVISOR_COMMAND --first-prompt-file '$(escape_single_quotes "$FIRST_PROMPT_FILE")'"
fi

# Extra supervisor arguments from the environment — the hook crash recovery
# rides (recover-crashed-seats.py sets --resume-session-id through it,
# nedschorus#120). An environment variable rather than a flag because the
# launcher's argument surface is operator-facing and stable, while this is
# machinery-to-machinery; callers own the quoting of what they pass.
if [ -n "${LAUNCH_CLAUDE_SUPERVISOR_EXTRA_ARGUMENTS:-}" ]; then
    SUPERVISOR_COMMAND="$SUPERVISOR_COMMAND $LAUNCH_CLAUDE_SUPERVISOR_EXTRA_ARGUMENTS"
fi

# When the supervisor exits, the pane becomes an interactive shell in the
# agent's directory rather than closing (user-ruled 2026-08-17): a stopped
# seat is relaunched in place, with no hunt for the right cd. The options are
# printed supervised-first, because `claude --continue` starts no supervisor
# and its seat can never recycle (nedschorus#45). The tmux session — and so the window — now outlives the
# supervisor and closes when this shell exits. Re-running the launcher on
# such a session ATTACHES to that shell (new-session -A ignores the command
# for an existing name); the printed options cover it. The leading trap lets
# the wrapper survive a Ctrl-C aimed at the supervisor — the tty signals the
# whole foreground group, and an untrapped wrapper died before reaching the
# shell (review finding, 2026-08-17); a handled trap, unlike an ignore, is
# not inherited, so the supervisor's own Ctrl-C handling is untouched.
# Attached launches only: a --no-attach seat keeps the old close-on-exit
# behavior, because a shell nobody is watching in a detached session would
# leak, and would turn the "already running" refusal below into a lie
# automation acts on (review finding, 2026-08-17).
AFTER_EXIT_COMMAND="echo; \
echo \"launch-claude-mac: the $AGENT_NAME supervisor exited; this shell is in the seat's directory\"; \
echo \"  fresh supervised seat:  exit, then launch-claude-mac $AGENT_NAME\"; \
echo \"  resume this dialog:     claude --continue — starts NO supervisor, so that\"; \
echo \"                          seat can never recycle until it is recovered\"; \
cd '$QUOTED_AGENT_DIRECTORY'; exec \${SHELL:-/bin/sh}"

# The chained set-option calls tell the terminal the session name, so the
# tab reads the seat's name rather than the command that happened to start
# it. They ride the same tmux invocation (\; separates tmux commands, not
# shell ones) because the seat's server does not exist before its first
# session does — a standalone set-option beforehand would find no server —
# and repeating them on an attach is harmless.
if [ "$ATTACH" = yes ]; then
    exec tmux -L "$SEAT_TMUX_SOCKET" new-session -A -s "$AGENT_NAME" -c "$AGENT_DIRECTORY" \
        "trap ':' INT QUIT; $SUPERVISOR_COMMAND; $AFTER_EXIT_COMMAND" \; \
        set-option -g set-titles on \; set-option -g set-titles-string '#S'
fi
tmux -L "$SEAT_TMUX_SOCKET" new-session -d -s "$AGENT_NAME" -c "$AGENT_DIRECTORY" "$SUPERVISOR_COMMAND" \; \
        set-option -g set-titles on \; set-option -g set-titles-string '#S' 2>/dev/null \
    || echo "launch-claude-mac: a tmux session named $AGENT_NAME already exists — a running seat, or its after-exit shell (attach with: launch-claude-mac $AGENT_NAME)"
