#!/bin/sh
# launch-claude-mac <name> [--no-attach] — reach the named agent ON THIS MAC.
#
# The local twin of launch-claude-ubuntu, sharing every convention and none of
# the SSH: the name you type is the whole configuration, the agent's directory
# is $NEDSCHORUS_AGENTS_ROOT/<name> (default ~/agents/<name>), created on first
# use, and a CLAUDE.local.md in that directory supplies the agent's identity —
# without one the agent is generic and the name is just a label.
#
# Which twin to type: the Ubuntu box is the default home for agent work (more
# memory, CPU and bandwidth, and it does not compete with the user's machine).
# Use THIS script only for work that must run where the user sits — anything
# needing the Mac's browser session, its keychain, its GUI, or files that live
# only on it. The machine is in both names because the choice is a real one and
# the wrong pick is easy to make.
#
# Attach-or-create comes from tmux: `new-session -A` attaches to the session
# named <name> when it exists and creates it when it does not, so a closed
# terminal window never orphans an agent — type the same command to reconnect.
# Inside the session runs the handoff supervisor, which launches the claude
# session, recycles it on every handoff, and exits when its agent stops without
# handing off. On an ATTACHED launch the pane then drops into an interactive
# shell in the agent's directory (surviving a Ctrl-C aimed at the supervisor),
# so the seat can be resumed in place with `claude --continue` and no hunting
# for the right cd (user-ruled 2026-08-17) — the tmux session closes when that
# shell exits. A seat born with --no-attach keeps the old close-on-exit
# behavior instead, even if attached later: its pane command is fixed at
# creation. A second launch of a running name attaches instead of
# duplicating, and the supervisor holds a per-agent lock that refuses a
# second copy even if tmux is bypassed.
# Both protections are per-machine, as is every other thing an agent owns, so
# the same name used on both machines is simply two unrelated agents — no
# conflict, only a label you cannot tell apart in a listing spanning both.
#
# --no-attach creates the session without attaching this terminal (for scripts
# and checks); attach later by running the plain form.
#
# Requires on this Mac: tmux, python3, and claude on the PATH.

set -eu

AGENTS_ROOT="${NEDSCHORUS_AGENTS_ROOT:-$HOME/agents}"

# The supervisor is this script's sibling, so the checkout location is never
# configured and never wrong — wherever this script was run from IS the
# checkout it belongs to.
SCRIPT_DIRECTORY=$(cd "$(dirname "$0")" && pwd)
SUPERVISOR="$SCRIPT_DIRECTORY/handoff-supervisor.py"

# The no-name case is the common mistake, so it teaches rather than scolds:
# what a name is for, and which agents are running right now to pick from or
# avoid colliding with.
usage() {
    echo "usage: launch-claude-mac <name> [--no-attach] [--first-prompt-file <path>]" >&2
    echo >&2
    echo "Every agent is named, and the name is the whole configuration: it names the" >&2
    echo "tmux session, the home directory ($AGENTS_ROOT/<name>), and the agent's handoff" >&2
    echo "files. Running a name that is already up ATTACHES to that agent — you cannot" >&2
    echo "start a second copy of one." >&2
    echo >&2
    running=$(tmux list-sessions -F '#{session_name}' 2>/dev/null | tr '\n' ' ')
    if [ -n "$running" ]; then
        echo "Agent tmux sessions on this Mac now (live seats or after-exit shells): $running" >&2
    else
        echo "No agent tmux sessions on this Mac now." >&2
    fi
    echo "(Agents on the Ubuntu box are separate: launch-claude-ubuntu.)" >&2
    echo >&2
    echo "The two machines share no agent state — tmux sessions, home directories," >&2
    echo "handoff files and locks are all per-machine — so the same name on both is two" >&2
    echo "unrelated agents, not a conflict. Suffix names (-mac, -ubuntu) only if you want" >&2
    echo "to tell them apart at a glance; nothing here requires it." >&2
    exit 2
}

[ $# -ge 1 ] || usage
AGENT_NAME="$1"
shift
ATTACH=yes
FIRST_PROMPT_FILE=""
while [ $# -gt 0 ]; do
    case "$1" in
        (--no-attach) ATTACH=no; shift ;;
        (--first-prompt-file) FIRST_PROMPT_FILE="${2:?--first-prompt-file needs a path}"; shift 2 ;;
        (*) usage ;;
    esac
done
case "$AGENT_NAME" in
    (*[!a-zA-Z0-9_-]*|"") echo "launch-claude-mac: agent names are letters, digits, - and _" >&2; exit 2 ;;
esac

# Every prerequisite is checked before anything is created, and each failure
# names its own fix: a launcher that half-starts an agent is worse than one
# that refuses.
command -v tmux >/dev/null 2>&1 || {
    echo "launch-claude-mac: tmux is not installed on this Mac — install it (brew install tmux) and re-run" >&2
    exit 2
}
command -v claude >/dev/null 2>&1 || {
    echo "launch-claude-mac: claude is not on the PATH — install Claude Code on this Mac and re-run" >&2
    exit 2
}
[ -f "$SUPERVISOR" ] || {
    echo "launch-claude-mac: no handoff-supervisor.py beside this script ($SUPERVISOR) — run the copy inside a nedschorus checkout" >&2
    exit 2
}

# Update Claude Code before starting the seat: background auto-update is off
# on the fleet (nedschorus#62), and launch is the chosen moment instead —
# every fresh agent starts current. Running sessions are unaffected by an
# update (user-established across many updates: installed versions are
# retained on disk). A failed or slow update warns and proceeds, because an
# update problem must never block starting an agent.
UPDATE_TIMEOUT="${LAUNCH_CLAUDE_UPDATE_TIMEOUT_SECONDS:-45}"
echo "launch-claude-mac: checking for a Claude Code update"
perl -e 'alarm shift; exec @ARGV' "$UPDATE_TIMEOUT" claude update \
    || echo "launch-claude-mac: claude update failed or timed out; launching on the installed version" >&2

AGENT_DIRECTORY="$AGENTS_ROOT/$AGENT_NAME"
mkdir -p "$AGENT_DIRECTORY"

# Pre-trust the agent directory: a fresh directory otherwise stops at Claude's
# one-time folder-trust dialog, which a detached launch can never answer and an
# attached one should not have to.
python3 -c 'import json,os,sys
path = os.path.expanduser("~/.claude.json")
settings = json.load(open(path)) if os.path.exists(path) else {}
target = os.path.abspath(os.path.expanduser(sys.argv[1]))
settings.setdefault("projects", {}).setdefault(target, {})["hasTrustDialogAccepted"] = True
json.dump(settings, open(path, "w"), indent=2)' "$AGENT_DIRECTORY"

# The agent's home must be a CHECKOUT before the session starts, not after:
# project settings — status line, the recycle Stop hook, the instruction-file
# guard — are read from .claude/ inside the working directory at session
# start, so an agent booted into a bare directory runs with none of them, and
# fixing its own home later cannot retrofit the session it is already in.
# Skipped when the home is already a checkout; an existing branch is reused,
# since git allows a branch in only one worktree at a time.
REPOSITORY=$(cd "$SCRIPT_DIRECTORY/.." && pwd)
if ! git -C "$AGENT_DIRECTORY" rev-parse --show-toplevel >/dev/null 2>&1; then
    git -C "$REPOSITORY" fetch --quiet origin || true
    git -C "$REPOSITORY" worktree add "$AGENT_DIRECTORY" -b "$AGENT_NAME" origin/main 2>/dev/null \
        || git -C "$REPOSITORY" worktree add "$AGENT_DIRECTORY" "$AGENT_NAME" \
        || echo "launch-claude-mac: could not make $AGENT_DIRECTORY a checkout; the agent will start without project settings" >&2
fi

# Boot-time worktree report: finished session worktrees pile up invisibly,
# so each launch names any that are done (clean, landed, vacant) and the
# command that removes them. Report only — removal stays a deliberate,
# separate call — and a report problem never blocks a launch.
python3 "$SCRIPT_DIRECTORY/clean-worktrees.py" --only-done || true

# Boot-time freshness: fast-forward the machine's reference checkout to
# origin/main (ff-only, never a merge — it carries no work of its own by
# construction). The mid-session half runs as a Stop hook
# (scripts/checkout-freshness-catch-up.py); this covers machines between
# sessions, and never blocks a launch.
python3 "$SCRIPT_DIRECTORY/checkout-freshness-catch-up.py" --reference-pull --repo "$REPOSITORY" 2>/dev/null || true

# tmux tells the terminal the session name, so the tab reads the seat's name
# rather than the command that happened to start it. Global option, harmless
# to repeat on each launch.
tmux set-option -g set-titles on 2>/dev/null || true
tmux set-option -g set-titles-string '#S' 2>/dev/null || true

SUPERVISOR_COMMAND="export PATH=\"\$HOME/.local/bin:\$PATH\"; \
python3 '$SUPERVISOR' --agent '$AGENT_NAME' --cd '$AGENT_DIRECTORY'"

# A first-prompt file seeds only the FIRST session. The supervisor reads the
# file itself, so its content never rides through shell quoting.
if [ -n "$FIRST_PROMPT_FILE" ]; then
    SUPERVISOR_COMMAND="$SUPERVISOR_COMMAND --first-prompt-file '$FIRST_PROMPT_FILE'"
fi

# When the supervisor exits, the pane becomes an interactive shell in the
# agent's directory rather than closing (user-ruled 2026-08-17): a stopped
# seat is resumed in place by typing `claude --continue`, with no hunt for
# the right cd. The tmux session — and so the window — now outlives the
# supervisor and closes when this shell exits. Re-running the launcher on
# such a session ATTACHES to that shell (new-session -A ignores the command
# for an existing name); the printed options cover it. The leading trap lets
# the wrapper survive a Ctrl-C aimed at the supervisor — the tty signals the
# whole foreground group, and an untrapped wrapper died before reaching the
# shell (review finding, 2026-08-17); a handled trap, unlike an ignore, is
# not inherited, so the supervisor's own Ctrl-C handling is untouched.
# Attached launches only: a --no-attach seat keeps the old close-on-exit
# behavior, because a shell nobody is watching in a detached session would
# leak, and would turn the "already running" refusal below into a lie
# automation acts on (review finding, 2026-08-17).
AFTER_EXIT_COMMAND="echo; \
echo \"launch-claude-mac: the $AGENT_NAME supervisor exited; this shell is in the seat's directory\"; \
echo \"  resume the last session:  claude --continue\"; \
echo \"  fresh supervised seat:    exit, then launch-claude-mac $AGENT_NAME\"; \
cd '$AGENT_DIRECTORY'; exec \${SHELL:-/bin/sh}"

if [ "$ATTACH" = yes ]; then
    exec tmux new-session -A -s "$AGENT_NAME" -c "$AGENT_DIRECTORY" \
        "trap ':' INT QUIT; $SUPERVISOR_COMMAND; $AFTER_EXIT_COMMAND"
fi
tmux new-session -d -s "$AGENT_NAME" -c "$AGENT_DIRECTORY" "$SUPERVISOR_COMMAND" 2>/dev/null \
    || echo "launch-claude-mac: a tmux session named $AGENT_NAME already exists — a running seat, or its after-exit shell (attach with: launch-claude-mac $AGENT_NAME)"
