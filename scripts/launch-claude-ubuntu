#!/bin/sh
# launch-claude-ubuntu <name> [--no-attach] — reach the named agent on the
# Ubuntu agent box, from the user's Mac. Its twin, launch-claude-mac, runs the
# same conventions locally on the Mac; the machine is in the name because the
# two are otherwise indistinguishable at the call site, and picking the wrong
# one is a real mistake to make.
#
# Fully dynamic, no roster (user-ruled 2026-08-07, nedschorus#45): the name you
# type is the whole configuration. The agent's directory is
# $NEDSCHORUS_AGENTS_ROOT/<name> on the box (default ~/agents/<name>), created
# on first use. A CLAUDE.local.md in that directory supplies the agent's
# identity; without one the agent is generic and the name is just a label.
# choirmaster is not registered anywhere — founding step 6 puts real content in
# its directory, and this script treats it like any other name.
#
# Attach-or-create comes from tmux on the box: `tmux new-session -A` attaches
# to the session named <name> when it exists and creates it when it does not,
# so a closed iTerm2 window never orphans an agent — type the same command to
# reconnect. Inside the session runs the handoff supervisor, which launches
# the claude session, reincarnates it on every handoff, and exits when its agent
# stops without handing off. On an ATTACHED launch the pane then drops into
# an interactive shell in the agent's directory (surviving a Ctrl-C aimed at
# the supervisor), so the seat can be resumed in place with
# `claude --continue` and no hunting for the right cd (user-ruled 2026-08-17)
# — the tmux session closes when that shell exits. That shell offers the
# SUPERVISED relaunch first and states what `claude --continue` costs: it
# resumes the dialog with no supervisor, so the seat can never reincarnate. The
# old ordering advertised --continue first, and on 2026-08-18 two seats ran
# unsupervised for about 25 hours because it was the only listed option that
# worked (nedschorus#45). A seat born with
# --no-attach keeps the old close-on-exit behavior instead, even if attached
# later: its pane command is fixed at creation. A second launch of a running
# name attaches instead of duplicating, and the supervisor's own lock
# refuses a duplicate even if tmux is bypassed.
# Both protections are per-machine, as is every other thing an agent owns, so
# nothing stops the same name on both machines. But the name is also the
# seat's Remote Control address, which agents on the other machine send to,
# so names are unique across the whole fleet; nothing enforces that here.
#
# Every seat runs on its OWN tmux server on the box (`tmux -L <name>`, one
# socket per seat under /tmp/tmux-<uid>/), so one server crash cannot take
# the whole per-machine fleet down: on 2026-08-21 the Mac's single default
# tmux server died and killed all three Mac seats at once. Seats launched
# before that change still live on the box's default server; the socket
# selection below reaches them there instead of starting a duplicate.
#
# --no-attach creates the session without attaching this terminal (for
# scripts and checks); attach later by running the plain form. An attached
# window reconnects on its own when the connection drops (see the attach
# loop below); a detached launch does not, it is one ssh command.
#
# Requires on the box: tmux, claude on ~/.local/bin, ~/Projects/nedschorus.

set -eu

# AGENTS_ROOT is a BOX-side path. A leading ~ is carried to the box as its
# $HOME; any other character — spaces and apostrophes included — travels
# literally, escaped per parse layer below. A ~user/ form is REFUSED rather
# than half-working: the box shell would treat the quoted value as a literal
# directory named ~user while the fleet's Python tools expanduser() it to
# that user's real home — one seat, silently split across two directories
# (PR #137 review P3, user-ruled 2026-08-22: overrides either work or are
# blocked). Agent names stay charset-checked: they ride in more places than
# paths do.
AGENT_BOX="${NEDSCHORUS_AGENT_BOX:-ned}"
AGENTS_ROOT="${NEDSCHORUS_AGENTS_ROOT:-~/agents}"
case "$AGENTS_ROOT" in
    ("~"[!/]*)
        echo "launch-claude-ubuntu: ~user agents roots are not supported — the box shell and the fleet's Python tools resolve them to different directories, splitting the seat. Use an absolute box-side path." >&2
        exit 2 ;;
esac

# The no-name case is the common mistake, so it teaches rather than scolds:
# what a name is for, and which agents are up on the box right now to pick from
# or avoid colliding with. The listing costs one SSH round trip and happens
# only on this error path, never on a launch.
usage() {
    echo "usage: launch-claude-ubuntu <name> [--no-attach] [--first-prompt-file <box-path>]" >&2
    echo >&2
    echo "Every agent is named, and the name is the whole configuration: it names the" >&2
    echo "tmux session on the box, the home directory ($AGENTS_ROOT/<name>), and the" >&2
    echo "agent's handoff files. Running a name that is already up ATTACHES to that" >&2
    echo "agent — you cannot start a second copy of one." >&2
    echo >&2
    # Per-seat tmux servers: one list-sessions cannot see every seat, so walk
    # every socket in the box's tmux socket directory — per-seat servers and
    # the default server (where pre-2026-08-21 seats still live) alike.
    # Single-quoted so the loop expands on the box, not on this Mac.
    running=$(ssh -o ConnectTimeout=5 "$AGENT_BOX" \
        'for seat_socket_path in "${TMUX_TMPDIR:-/tmp}/tmux-$(id -u)"/*; do
             [ -S "$seat_socket_path" ] || continue
             tmux -S "$seat_socket_path" list-sessions -F "#{session_name}@$(basename "$seat_socket_path")" 2>/dev/null || true
         done | sort -u' 2>/dev/null | tr '\n' ' ')
    if [ -n "$running" ]; then
        echo "Agent tmux sessions on the box now (live seats or after-exit shells): $running" >&2
    else
        echo "No agent tmux sessions on the box now (or it could not be reached)." >&2
    fi
    echo "(Agents on this Mac are separate: launch-claude-mac.)" >&2
    echo >&2
    echo "The two machines share no agent state — tmux sessions, home directories," >&2
    echo "handoff files and locks are all per-machine — but a name is also the seat's" >&2
    echo "Remote Control address, which agents on the other machine send to, so names are" >&2
    echo "unique across the whole fleet. Nothing on either machine enforces that." >&2
    exit 2
}

[ $# -ge 1 ] || usage
AGENT_NAME="$1"
shift
ATTACH=yes
FIRST_PROMPT_FILE=""
while [ $# -gt 0 ]; do
    case "$1" in
        (--no-attach) ATTACH=no; shift ;;
        (--first-prompt-file) FIRST_PROMPT_FILE="${2:?--first-prompt-file needs a box-side path}"; shift 2 ;;
        (*) usage ;;
    esac
done
case "$AGENT_NAME" in
    (*[!a-zA-Z0-9_-]*|"") echo "launch-claude-ubuntu: agent names are letters, digits, - and _" >&2; exit 2 ;;
esac

# Which GitHub account a box seat acts as — the twin of the same block in
# scripts/launch-claude-mac, where the ruling it applies (credential ruling
# C4 in nc-systems/main-gatekeeper/main-gatekeeper-design.md: each agent host
# holds a fine-grained token for this repository only, never a classic
# all-repository token and never the `workflow` scope) and the measured
# defect it closes are written out in full. The default here is the BOX's
# account. Measured on the box 2026-09-22: `gh` is logged in as
# `ubuntu-claude` — the right identity already — but with a CLASSIC token
# carrying read:org, repo and workflow, and there is no
# `ubuntu-claude.token` file on the box at all, only copies of
# `mac-claude.token` and `ned-review-merge.token`. So until that file is
# written, every box launch takes the warning branch below by design.
#
# Charset-checked for the same two reasons as the Mac twin: the value is
# spliced into a command that crosses BOTH parses, and letters, digits, -
# and _ need no escaping at either; and an override either works or is
# blocked, never a third state (user-ruled 2026-08-22).
SEAT_GITHUB_ACCOUNT="${NEDSCHORUS_SEAT_GITHUB_ACCOUNT:-ubuntu-claude}"
case "$SEAT_GITHUB_ACCOUNT" in
    (*[!a-zA-Z0-9_-]*|"") echo "launch-claude-ubuntu: NEDSCHORUS_SEAT_GITHUB_ACCOUNT is a GitHub account name — letters, digits, - and _" >&2; exit 2 ;;
esac
SEAT_GITHUB_TOKEN_FILE_UNDER_HOME=".config/nedschorus/$SEAT_GITHUB_ACCOUNT.token"

# Every operator value spliced into the remote command is escaped for the
# parses it actually crosses (PR #134's review arc: hand-written quotes here
# broke on an apostrophe, and the ssh command's double-quote wrapper expanded
# $ inside values box-side). The layers: the box's login shell parses the
# whole ssh command once (P1), and tmux's shell parses the pane command
# again (P2). escape_single_quotes prepares a value for one single-quoted
# parse; escape_remote_double_quote_context makes it inert through one
# double-quote-context parse; sites compose the two by depth. AGENT_NAME
# needs neither (charset-checked above). The launch-claude-ubuntu-test.py
# harness replays all layers with a real sh — trust it over derivation.
escape_single_quotes() {
    printf "%s" "$1" | sed "s/'/'\\\\''/g"
}
escape_remote_double_quote_context() {
    printf "%s" "$1" | sed 's/[$`"\\]/\\&/g'
}

AGENT_DIRECTORY="$AGENTS_ROOT/$AGENT_NAME"
# The P1 form, spliced as \"$AGENT_DIRECTORY_REMOTE\": a leading ~ becomes
# $HOME so the box still resolves its own home inside the quotes (bare ~
# would stay literal there); ~user/ forms are refused above. Everything
# else is escaped so P1 neither expands nor splits it.
case "$AGENTS_ROOT" in
    ("~") AGENTS_ROOT_REMOTE="\$HOME" ;;
    ("~/"*) AGENTS_ROOT_REMOTE="\$HOME$(escape_remote_double_quote_context "${AGENTS_ROOT#?}")" ;;
    (*) AGENTS_ROOT_REMOTE=$(escape_remote_double_quote_context "$AGENTS_ROOT") ;;
esac
AGENT_DIRECTORY_REMOTE="$AGENTS_ROOT_REMOTE/$AGENT_NAME"
# The P2 form, spliced between single quotes inside the pane command: quoted
# for P2, then made inert through P1's double-quote context. A literal ~
# reaching the supervisor is fine — it expanduser()s its --cd itself.
AGENT_DIRECTORY_SUPERVISOR=$(escape_remote_double_quote_context "$(escape_single_quotes "$AGENT_DIRECTORY")")

# Task-list persistence across seat generations — the twin of the same block
# in scripts/launch-claude-mac, where the mechanism and its two warnings are
# written out in full. In short: the harness keys its native task store by
# CLAUDE_CODE_TASK_LIST_ID when set and by the session id otherwise, so
# binding the id to the seat's NAME gives every generation of that seat the
# same list rather than a fresh empty one, and CLAUDE_CODE_ENABLE_TODO_TOOLS=1
# is what makes the task tools exist at all on current models (Claude Code
# 2.1.233 withdrew them from Opus 4.8, Sonnet 5, Fable 5, Mythos 5 and newer).
# Ported from the legacy system's
# ~/Projects/nedlern/tasks/sessions/.agent-wrapper.sh:341.
#
# Warning 1 — the store is ONE copy on ONE disk outside the repository, here
# $HOME/.claude/tasks/nedschorus-<name>-tasks/ ON THE BOX. It is not committed and not
# shared with the Mac, so the same seat name on both machines keeps two
# unrelated lists.
#
# Warning 2 — a session started OUTSIDE this launcher binds elsewhere, and
# the failure is silent: TaskList returns empty and TaskUpdate answers "Task
# not found", both looking exactly like a seat with no tasks. The after-exit
# shell inherits this export so the `claude --continue` it offers keeps the
# binding; a `claude` typed in any other shell on the box does not.
#
# No escaping is needed on the composed id at either parse layer: AGENT_NAME
# is charset-checked above to letters, digits, - and _, and the single quotes
# ride through P1's double-quote context to be parsed by the pane shell at
# P2, exactly as --agent does on the next line.
# The one-time store migration and the prefixed id, box-side, both inside
# the pane command because $HOME here is the BOX's home at P2 — same rename
# and same never-overwrite rule as the Mac twin (user-ruled 2026-08-29).
#
# The seat's own GitHub credential, box-side — the twin of the same block
# in scripts/launch-claude-mac, where the mechanism is written out in full.
# The one thing that is the BOX's, and the reason both twins read the file
# with `IFS= read -r` rather than `$(cat ...)`: this pane command crosses
# TWO parses, and a `$(...)` reaching the box's login shell at P1 is run
# THERE — the box would substitute the token into the string it then hands
# tmux, which is a `ps` listing on the box carrying the credential for as
# long as the seat lives. Measured 2026-09-22 against this suite's
# tmux-argv capture, which is the post-P1 text: with `$(cat ...)` the token
# stands in it; with the read below it does not, and the value is present
# only in the supervisor's environment. A redirection has no such
# behaviour: `<` is an ordinary character inside P1's double-quote context
# and a redirection at P2, where the seat's own shell performs the read.
#
# The leading `unset GH_TOKEN` makes the prepare step's warning true rather
# than nearly true: the seat's account is decided by this launcher, never
# inherited from whatever shell the pane was started under.
#
# The override variable itself needs no unset on this side, where the Mac
# twin needs one: nothing here exports it to the box. ssh forwards no
# environment, and the value reaches the box only as text inside the
# composed command — the same reason this twin does not unset the
# extra-arguments hook variable either.
#
# The `if` keeps GH_TOKEN UNSET rather than empty when the file is absent,
# which is the box's ordinary state today — `gh` falls back to its keyring
# login on an unset variable and fails outright on an empty one. It
# re-checks box-side what the prepare step's warning checks box-side a
# moment earlier; the check that decides is this one, in the seat's own
# shell. \$HOME is escaped so the BOX's home is the one resolved, exactly
# as the task-list migration line beside it does, and SEAT_GITHUB_ACCOUNT
# needs no escaping at either parse (charset-checked above).
#
# The after-exit shell inherits this export, as it inherits the task-list
# pin, and for the same reason: the `claude --continue` it offers is the
# same seat, and a `gh` typed there is the seat acting.
SUPERVISOR_COMMAND="export PATH=\"\$HOME/.local/bin:\$PATH\"; \
unset GH_TOKEN; if [ -s \"\$HOME/$SEAT_GITHUB_TOKEN_FILE_UNDER_HOME\" ]; then IFS= read -r GH_TOKEN < \"\$HOME/$SEAT_GITHUB_TOKEN_FILE_UNDER_HOME\"; export GH_TOKEN; fi; \
if [ -d \"\$HOME/.claude/tasks/$AGENT_NAME-tasks\" ] && [ ! -e \"\$HOME/.claude/tasks/nedschorus-$AGENT_NAME-tasks\" ]; then mv \"\$HOME/.claude/tasks/$AGENT_NAME-tasks\" \"\$HOME/.claude/tasks/nedschorus-$AGENT_NAME-tasks\"; fi; \
export CLAUDE_CODE_TASK_LIST_ID='nedschorus-$AGENT_NAME-tasks'; \
export CLAUDE_CODE_ENABLE_TODO_TOOLS=1; \
python3 \$HOME/Projects/nedschorus/nc-systems/handoff/handoff-supervisor.py \
--agent '$AGENT_NAME' --cd '$AGENT_DIRECTORY_SUPERVISOR'"

# A first-prompt file (box-side path) seeds only the FIRST session — used for
# the founding boot, where the committed handoff is the prompt. The supervisor
# reads the file itself, so its content never rides through shell quoting.
# After the first reincarnation the ordinary initial agent instructions take over.
if [ -n "$FIRST_PROMPT_FILE" ]; then
    SUPERVISOR_COMMAND="$SUPERVISOR_COMMAND --first-prompt-file '$(escape_remote_double_quote_context "$(escape_single_quotes "$FIRST_PROMPT_FILE")")'"
fi

# Extra supervisor arguments from the environment — the same hook as the Mac
# twin (launch-claude-mac), which resupervise-seat.py rides to hand a
# box-local --handoff-dir to the box-side supervisor. Machinery-to-machinery:
# the caller quotes the value for the supervisor's own shell parse (one
# parse, same contract as the Mac twin), and each launcher owns its
# transport's transparency — here that means making the value inert through
# the ssh command's double-quote context, so both twins read a caller's
# quoting identically.
if [ -n "${LAUNCH_CLAUDE_SUPERVISOR_EXTRA_ARGUMENTS:-}" ]; then
    SUPERVISOR_COMMAND="$SUPERVISOR_COMMAND $(escape_remote_double_quote_context "$LAUNCH_CLAUDE_SUPERVISOR_EXTRA_ARGUMENTS")"
fi

# Update Claude Code on the box before starting the seat, so a fresh agent
# starts current. Launch is no longer the fleet's ONLY update moment: since
# 2026-09-22 handoff-supervisor.py updates before every session it launches,
# which covers the handoff restart, crash recovery and the login restart
# (see update_agent_binary there). Background
# auto-update is off via DISABLE_AUTOUPDATER in the checked-in
# .claude/settings.json (user-ruled 2026-08-22: with launch-time updates,
# the mid-session update banner is clutter); that switch leaves this
# explicit `claude update` working. Running sessions are unaffected by an
# update (user-established across many updates: installed versions are
# retained on disk). A failed or slow update proceeds anyway, because an
# update problem must never block starting an agent: `|| true` is what
# holds that here, and it is load-bearing twice over, because the
# PREPARE_COMMAND chain below joins this command to the box-side
# preparation with `&&` — a non-zero update would take the home directory,
# the worktree and the seat with it.
#
# The update runs under the machine-wide lock in
# scripts/agent-binary-update-under-lock.py, box-side, which the box's
# supervisors take too, so no two updates on the box overlap (user-approved
# 2026-09-22): a login restart otherwise starts one supervisor's update
# about 6 s after the last. That file owns the timeout as well, replacing
# GNU timeout here, and says why: kept outside it, timeout would kill the
# Python holding the lock and orphan a still-running update. One budget
# covers waiting for the lock and running the update together.
#
# The launcher writes no warning of its own: `claude update` prints its own
# diagnosis whenever it runs to completion, and the warning removed on
# 2026-08-31 could not see the failure that actually happened. The twin
# carries that case in full. The helper reports only what it causes,
# prefixed with this launcher's name: an update it killed at the limit, a
# wait for the lock, and an update it skipped because the lock stayed held
# past the limit. The limit is 120 seconds, raised from 45 (user-ruled
# 2026-08-31), because a slow but WORKING update killed at the limit leaves
# the box silently on its old version; the limit bounds a hung update rather
# than racing a real download. A limit of 0 skips the update.
#
# The brace group with `|| true` is one && operand that always succeeds, so
# the chain below is unaffected by the update's status.
# The twin does the same locally, at scripts/launch-claude-mac.
UPDATE_COMMAND="export PATH=\"\$HOME/.local/bin:\$PATH\"; \
echo 'launch-claude-ubuntu: checking for a Claude Code update'; \
{ python3 \$HOME/Projects/nedschorus/scripts/agent-binary-update-under-lock.py \
--program-name launch-claude-ubuntu \
--timeout-seconds \${LAUNCH_CLAUDE_UPDATE_TIMEOUT_SECONDS:-120} \
-- claude update || true; }"

# Pre-trust the agent directory on the box: a fresh directory otherwise stops
# at Claude's one-time folder-trust dialog, which a detached launch can never
# answer and an attached one should not have to.
#
# The flag is written through a temporary sibling that REPLACES the box's
# ~/.claude.json, never by truncating it (as this step did until 2026-09-08):
# that file is the harness's own live state file, written by every running
# session, so a truncate-and-stream is a file the harness can read torn. The
# reasoning in full, its precedent (write_atomically in
# nc-systems/main-gatekeeper/main-gatekeeper.py), the two places it departs from that
# precedent, and what it deliberately does not fix — the read-modify-write,
# and why no lock — are at the Mac twin, scripts/launch-claude-mac. Two
# things here are the BOX's:
#   - the program crosses P1 between SINGLE quotes, so it may contain no
#     single quote of its own: every string in it is double-quoted, and the
#     \" pairs below are this Mac's escaping of that double quote, which
#     reaches the box as a plain " inside the single-quoted program;
#   - the temporary file is created with dir= the target's OWN directory,
#     which os.path.dirname resolves from the box-side ~ this program
#     expands there. The rename is then within one filesystem — the box's
#     $HOME — which is what makes it atomic. A temporary left to TMPDIR
#     would not be: os.replace across filesystems raises rather than
#     renaming, and a machine whose /tmp is its own filesystem is the
#     ordinary case, not the exotic one.
PREPARE_COMMAND="$UPDATE_COMMAND && mkdir -p \"$AGENT_DIRECTORY_REMOTE\" && python3 -c 'import json,os,pathlib,sys,tempfile; \
p=os.path.expanduser(\"~/.claude.json\"); \
d=json.load(open(p)) if os.path.exists(p) else {}; \
t=os.path.abspath(os.path.expanduser(sys.argv[1])); \
d.setdefault(\"projects\",{}).setdefault(t,{})[\"hasTrustDialogAccepted\"]=True; \
m=os.stat(p).st_mode & 0o777 if os.path.exists(p) else 0o600; \
h,w=tempfile.mkstemp(dir=os.path.dirname(p),prefix=\".claude.json.\",suffix=\".launch-claude-writing\"); \
os.close(h); \
pathlib.Path(w).write_text(json.dumps(d,indent=2),encoding=\"utf-8\"); \
os.chmod(w,m); \
os.replace(w,p)' \"$AGENT_DIRECTORY_REMOTE\""

# The agent's home must be a CHECKOUT before the session starts, not after.
# Project settings — the status line, the reincarnation Stop hook, the
# instruction-file guard — are read from .claude/ inside the working
# directory at session start, so an agent booted into a bare directory runs
# with none of them, and fixing its own home later cannot retrofit the
# session it is already in (observed 2026-08-14: a seat launched into an
# empty ~/agents/gatekeeper had no status line and no hooks). Skipped when
# the home is already a checkout, so relaunches are untouched; a branch that
# already exists is reused rather than recreated, since git allows a branch
# in only one worktree at a time.
PREPARE_COMMAND="$PREPARE_COMMAND && \
if ! git -C \"$AGENT_DIRECTORY_REMOTE\" rev-parse --show-toplevel >/dev/null 2>&1; then \
  git -C \$HOME/Projects/nedschorus fetch --quiet origin || true; \
  git -C \$HOME/Projects/nedschorus worktree add \"$AGENT_DIRECTORY_REMOTE\" -b '$AGENT_NAME' origin/main 2>/dev/null \
  || git -C \$HOME/Projects/nedschorus worktree add \"$AGENT_DIRECTORY_REMOTE\" '$AGENT_NAME' \
  || echo \"launch-claude-ubuntu: could not make $AGENT_DIRECTORY_REMOTE a checkout; the agent will start without project settings\" >&2; \
fi"

# Boot-time worktree report on the box — the twin of the same step in
# launch-claude-mac: names any finished session worktree and the command
# that removes it. Report only, and never blocks the launch.
PREPARE_COMMAND="$PREPARE_COMMAND && { python3 \$HOME/Projects/nedschorus/scripts/clean-worktrees.py --only-done || true; }"

# Boot-time freshness on the box — the twin of the same step in
# launch-claude-mac: fast-forward the reference checkout to origin/main
# (ff-only, never a merge). A stale copy of this script freshens the
# checkout that carries its replacement, so the next launch runs current.
PREPARE_COMMAND="$PREPARE_COMMAND && { python3 \$HOME/Projects/nedschorus/scripts/checkout-freshness-catch-up.py --reference-pull --repo \$HOME/Projects/nedschorus 2>/dev/null || true; }"

# A missing token file WARNS and launches anyway, rather than refusing
# (user-ruled 2026-09-22): the box holds no `ubuntu-claude.token` today, and
# a launcher that refused would take every box seat down at once over a
# credential that is an improvement, not a prerequisite. The warning is loud
# because the fallback is the defect this change exists to close.
#
# It rides the PREPARE step rather than the pane command, which is where the
# Mac twin differs and why: this launcher runs on the Mac and cannot see the
# box's filesystem, so the check has to happen box-side — and of the two
# box-side places, only this one reaches the operator. The prepare step runs
# in the ssh command, so its stderr comes back down the connection to the
# terminal that typed the launch, on the attached and the detached path
# alike; a warning inside the pane command would land in the seat's tmux
# pane, which a detached launch leaves nobody watching. An attach onto a
# seat that is already running skips this step, correctly: nothing is being
# started, so no credential is being chosen.
#
# Brace-grouped and always 0: the `&&` chain above joins the update, the
# trust mark and the checkout, and an un-grouped step that reported a
# missing file as a failure would abort the launch — the failure mode the
# SEAT_SOCKET_SELECTION_COMMAND comment below records, from PR [Per-seat
# tmux servers: one server per seat, so one crash cannot kill a machine's
# whole fleet](https://github.com/nedschorus/nedschorus/pull/122) review
# P2-3.
PREPARE_COMMAND="$PREPARE_COMMAND && { [ -s \"\$HOME/$SEAT_GITHUB_TOKEN_FILE_UNDER_HOME\" ] || { \
echo \"launch-claude-ubuntu: ============================================================\" >&2; \
echo \"launch-claude-ubuntu: NO SEAT TOKEN — $AGENT_NAME will NOT act as $SEAT_GITHUB_ACCOUNT\" >&2; \
echo \"launch-claude-ubuntu:   account wanted: $SEAT_GITHUB_ACCOUNT\" >&2; \
echo \"launch-claude-ubuntu:   file looked in: \$HOME/$SEAT_GITHUB_TOKEN_FILE_UNDER_HOME (on the box)\" >&2; \
echo \"launch-claude-ubuntu:   GH_TOKEN stays unset, so gh and git act as the keyring login gh holds on the box\" >&2; \
echo \"launch-claude-ubuntu:   write the fine-grained token for that account to that file on the box, mode 600, then relaunch this seat\" >&2; \
echo \"launch-claude-ubuntu:   or export NEDSCHORUS_SEAT_GITHUB_ACCOUNT naming an account whose token file is there\" >&2; \
echo \"launch-claude-ubuntu: ============================================================\" >&2; }; }"

# Per-seat tmux servers on the box (2026-08-21): every seat runs on its OWN
# tmux server, socket `-L <name>`, because a machine's single shared server
# dying takes every seat down at once — the Mac's did exactly that on
# 2026-08-21, killing all three Mac seats. Transition rule: seats launched
# before this change still live on the box's DEFAULT server, so when the
# seat's own server does not hold its session but the default one does, this
# launch reaches it there — otherwise attach-or-create would start a
# duplicate seat beside the running one. Runs on the box: \$SEAT_TMUX_SOCKET
# is escaped so the box expands it; `-L default` names the default socket,
# so one variable serves both cases. The twin does the same locally, at
# scripts/launch-claude-mac.
# Brace-grouped: the assignments and `if` end with `;`, and un-grouped those
# semicolons END the && list on the box — a failed PREPARE_COMMAND no longer
# aborted the launch, and tmux ran with an empty -L socket name (PR #122
# review P2-3). The group keeps the whole selection one && operand.
SEAT_SOCKET_SELECTION_COMMAND="{ SEAT_TMUX_SOCKET='$AGENT_NAME'; \
if ! tmux -L '$AGENT_NAME' has-session -t '=$AGENT_NAME' 2>/dev/null \
&& tmux -L default has-session -t '=$AGENT_NAME' 2>/dev/null; then SEAT_TMUX_SOCKET=default; fi; }"

# When the supervisor exits, the pane becomes an interactive shell in the
# agent's directory rather than closing (user-ruled 2026-08-17): a stopped
# seat is relaunched in place, with no hunt for the right cd. The options are
# printed supervised-first, because `claude --continue` starts no supervisor
# and its seat can never reincarnate (nedschorus#45). The tmux session now outlives the supervisor and closes when
# that shell exits. Re-running the launcher on such a session ATTACHES to
# that shell (new-session -A ignores the command for an existing name); the
# printed options cover it. The leading trap lets the wrapper survive a
# Ctrl-C aimed at the supervisor — the tty signals the whole foreground
# group, and an untrapped wrapper died before reaching the shell (review
# finding, 2026-08-17); a handled trap, unlike an ignore, is not inherited,
# so the supervisor's own Ctrl-C handling is untouched. Attached launches
# only: a --no-attach seat keeps the old close-on-exit behavior, because a
# shell nobody is watching in a detached session would leak, and would turn
# the "already running" refusal below into a lie automation acts on (review
# finding, 2026-08-17). The cd target is double-quoted at the PANE shell's
# parse (P2), one layer deeper than the P1 form: escaped once more so P1
# passes it through, with a leading ~ carried as a $HOME the pane shell
# expands. \${SHELL} is escaped so the box, not this Mac, names the shell.
# The twin does the same locally, at scripts/launch-claude-mac.
case "$AGENTS_ROOT" in
    ("~") AFTER_EXIT_ROOT="\\\$HOME" ;;
    ("~/"*) AFTER_EXIT_ROOT="\\\$HOME$(escape_remote_double_quote_context "$(escape_remote_double_quote_context "${AGENTS_ROOT#?}")")" ;;
    (*) AFTER_EXIT_ROOT=$(escape_remote_double_quote_context "$(escape_remote_double_quote_context "$AGENTS_ROOT")") ;;
esac
AFTER_EXIT_COMMAND="echo; \
echo 'launch-claude-ubuntu: the $AGENT_NAME supervisor exited; this shell is in the seat directory'; \
echo '  fresh supervised seat:  exit, then (from the Mac) launch-claude-ubuntu $AGENT_NAME'; \
echo '  resume this dialog:     claude --continue — starts NO supervisor, so that'; \
echo '                          seat can never reincarnate until it is recovered'; \
cd \\\"$AFTER_EXIT_ROOT/$AGENT_NAME\\\"; exec \${SHELL:-sh}"

# The chained set-option calls tell an iTerm2 tab the session name
# ("gatekeeper" rather than "ssh"). They ride the same tmux invocation
# because the seat's server does not exist before its first session does — a
# standalone set-option beforehand would find no server — and repeating them
# on an attach is harmless. \\; reaches the box as \;, a tmux command
# separator rather than a shell one.
# An attached window is the user's only view of a box seat, and iTerm2 closes
# the window when its process ends. So the attach is a loop, not an exec
# (nedschorus#116 window role, user-ruled 2026-09-14: box seats are not
# reconnected by hand). ssh exits 255 for a connection-level failure — the box
# rebooting, the connection dropped, the box not up yet — and for nothing
# else; on 255 the launcher waits and tries again, doubling the wait up to
# 30s, one line per attempt. Any other exit is the remote command's own
# status (a detach, the after-exit shell closing, a prepare step failing) and
# ends the launcher as before.
#
# Two things the remote side does before attaching, both because of a box
# that has just booted. First, it waits out the box's own seat restart:
# restart-live-seats-at-login.service runs seconds after boot, and sshd
# answers in the same second, so a reconnect can arrive before the seat is
# back; a `new-session -A` then would CREATE a fresh seat and the box's
# restart would find it live and refuse — the transcript resume lost. So
# while the seat is absent AND that unit is still activating, the remote
# side polls, bounded at 180s (the restart's 120s deadline plus its settle).
# On a box that has been up for hours the unit is inactive and the wait is
# nothing. Second, the prepare step — the Claude update, the trust mark, the
# checkout — runs only when the seat does NOT already exist: an attach onto a
# live seat has nothing to prepare, and N windows reconnecting after a boot
# would otherwise each run `claude update` at once under live sessions
# (nedschorus#62).
SEAT_EXISTS_COMMAND="{ tmux -L '$AGENT_NAME' has-session -t '=$AGENT_NAME' 2>/dev/null || tmux -L default has-session -t '=$AGENT_NAME' 2>/dev/null; }"
SEAT_RESTART_WAIT_COMMAND="{ SEAT_WAITED=0; \
while ! $SEAT_EXISTS_COMMAND && [ \"\$(systemctl --user is-active restart-live-seats-at-login.service 2>/dev/null)\" = activating ] && [ \$SEAT_WAITED -lt 180 ]; do \
[ \$SEAT_WAITED -eq 0 ] && echo 'launch-claude-ubuntu: the box is restarting its seats after a boot; waiting for $AGENT_NAME before attaching'; \
sleep 2; SEAT_WAITED=\$((SEAT_WAITED + 2)); done; }"
PREPARE_UNLESS_RUNNING_COMMAND="{ $SEAT_EXISTS_COMMAND || { $PREPARE_COMMAND; }; }"
if [ "$ATTACH" = yes ]; then
    # The wait doubles across failed attempts and resets once a session has
    # actually run: an ssh that lasted longer than RECONNECT_SESSION_SECONDS
    # was a live attach that dropped, not a failed retry, so the next
    # reconnect starts from 2s again rather than from wherever a boot's worth
    # of retries left it (PR #365 review).
    RECONNECT_WAIT_SECONDS=2
    RECONNECT_SESSION_SECONDS=60
    while :; do
        SSH_STATUS=0
        SSH_STARTED_AT=$(date +%s)
        ssh -t "$AGENT_BOX" \
            "$SEAT_RESTART_WAIT_COMMAND && $PREPARE_UNLESS_RUNNING_COMMAND && $SEAT_SOCKET_SELECTION_COMMAND && tmux -L \"\$SEAT_TMUX_SOCKET\" new-session -A -s '$AGENT_NAME' -c \"$AGENT_DIRECTORY_REMOTE\" \"trap ':' INT QUIT; $SUPERVISOR_COMMAND; $AFTER_EXIT_COMMAND\" \\; set-option -g set-titles on \\; set-option -g set-titles-string '#S'" \
            || SSH_STATUS=$?
        [ "$SSH_STATUS" -eq 255 ] || exit "$SSH_STATUS"
        [ $(( $(date +%s) - SSH_STARTED_AT )) -lt "$RECONNECT_SESSION_SECONDS" ] || RECONNECT_WAIT_SECONDS=2
        echo "launch-claude-ubuntu: the connection to $AGENT_BOX for $AGENT_NAME dropped or could not be made (ssh exit 255); retrying in ${RECONNECT_WAIT_SECONDS}s — Ctrl-C stops this window" >&2
        sleep "$RECONNECT_WAIT_SECONDS"
        [ "$RECONNECT_WAIT_SECONDS" -ge 30 ] || RECONNECT_WAIT_SECONDS=$((RECONNECT_WAIT_SECONDS * 2))
    done
fi
exec ssh "$AGENT_BOX" \
    "$PREPARE_COMMAND && $SEAT_SOCKET_SELECTION_COMMAND && tmux -L \"\$SEAT_TMUX_SOCKET\" new-session -d -s '$AGENT_NAME' -c \"$AGENT_DIRECTORY_REMOTE\" \"$SUPERVISOR_COMMAND\" \\; set-option -g set-titles on \\; set-option -g set-titles-string '#S' 2>/dev/null || echo 'launch-claude-ubuntu: a tmux session named $AGENT_NAME already exists — a running seat, or its after-exit shell (attach with: launch-claude-ubuntu $AGENT_NAME)'"
