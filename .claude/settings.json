{
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/scripts/handoff-context-threshold-hook.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/instruction-file-guard.py"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "design@claude-plugins-official": false,
    "cowork-plugin-management@claude-plugins-official": false,
    "productivity@claude-plugins-official": false
  },
  "skillOverrides": {
    "engineering:code-review": "off",
    "engineering:testing-strategy": "off",
    "engineering:architecture": "off",
    "engineering:system-design": "off",
    "engineering:tech-debt": "off",
    "engineering:documentation": "off",
    "engineering:deploy-checklist": "off",
    "engineering:incident-response": "off",
    "engineering:standup": "off",
    "anthropic-skills:morning": "off",
    "anthropic-skills:setup-cowork": "off",
    "anthropic-skills:schedule": "off"
  }
}
