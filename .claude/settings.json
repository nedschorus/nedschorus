{
  "statusLine": {
    "type": "command",
    "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}\"/scripts/session-statusline-command.py"
  },
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Bash(gh pr merge *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/scripts/handoff-context-threshold-hook.py"
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/scripts/checkout-freshness-catch-up.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/scripts/synthetic-keystroke-guard-hook.py",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/instruction-file-guard.py"
          },
          {
            "type": "command",
            "command": "sh -c 'GUARD=\"$CLAUDE_PROJECT_DIR/.claude/hooks/backup-and-snapshot-write-guard.py\"; [ -f \"$GUARD\" ] || GUARD=\"$PWD/.claude/hooks/backup-and-snapshot-write-guard.py\"; exec python3 \"$GUARD\"'"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "design@claude-plugins-official": false,
    "cowork-plugin-management@claude-plugins-official": false,
    "productivity@claude-plugins-official": false
  },
  "skillOverrides": {
    "engineering:code-review": "off",
    "engineering:testing-strategy": "off",
    "engineering:architecture": "off",
    "engineering:system-design": "off",
    "engineering:tech-debt": "off",
    "engineering:documentation": "off",
    "engineering:deploy-checklist": "off",
    "engineering:incident-response": "off",
    "engineering:standup": "off",
    "anthropic-skills:morning": "off",
    "anthropic-skills:setup-cowork": "off",
    "anthropic-skills:schedule": "off"
  }
}
