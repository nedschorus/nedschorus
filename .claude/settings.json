{
  "statusLine": {
    "type": "command",
    "command": "p=scripts/session-statusline-command.py; [ -f \"$p\" ] || p=\"${CLAUDE_PROJECT_DIR:-.}/$p\"; exec python3 \"$p\""
  },
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Bash(gh pr merge *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "p=scripts/handoff-context-threshold-hook.py; [ -f \"$p\" ] || p=\"$CLAUDE_PROJECT_DIR/$p\"; exec python3 \"$p\""
          },
          {
            "type": "command",
            "command": "p=scripts/checkout-freshness-catch-up.py; [ -f \"$p\" ] || p=\"$CLAUDE_PROJECT_DIR/$p\"; exec python3 \"$p\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "p=scripts/synthetic-keystroke-guard-hook.py; [ -f \"$p\" ] || p=\"$CLAUDE_PROJECT_DIR/$p\"; exec python3 \"$p\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "p=.claude/hooks/instruction-file-guard.py; [ -f \"$p\" ] || p=\"$CLAUDE_PROJECT_DIR/$p\"; exec python3 \"$p\""
          },
          {
            "type": "command",
            "command": "p=.claude/hooks/session-location-write-guard.py; [ -f \"$p\" ] || p=\"$CLAUDE_PROJECT_DIR/$p\"; exec python3 \"$p\""
          },
          {
            "type": "command",
            "command": "p=.claude/hooks/backup-and-snapshot-write-guard.py; [ -f \"$p\" ] || p=\"$CLAUDE_PROJECT_DIR/$p\"; exec python3 \"$p\""
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "design@claude-plugins-official": false,
    "cowork-plugin-management@claude-plugins-official": false,
    "productivity@claude-plugins-official": false
  },
  "skillOverrides": {
    "engineering:code-review": "off",
    "engineering:testing-strategy": "off",
    "engineering:architecture": "off",
    "engineering:system-design": "off",
    "engineering:tech-debt": "off",
    "engineering:documentation": "off",
    "engineering:deploy-checklist": "off",
    "engineering:incident-response": "off",
    "engineering:standup": "off",
    "anthropic-skills:morning": "off",
    "anthropic-skills:setup-cowork": "off",
    "anthropic-skills:schedule": "off"
  }
}
